<!-- Generated by scripts/generate-stretch-catalog.py -->
<resources>
    <string name="stretch_catalog_glute_title">仰卧臀部拉伸</string>
    <string name="stretch_catalog_glute_instruction">仰卧，将一侧脚踝搭在另一侧大腿上，再轻轻把双腿拉向胸前。</string>
    <string name="stretch_catalog_hamstring_title">仰卧大腿后侧拉伸</string>
    <string name="stretch_catalog_hamstring_instruction">仰卧抬起一条腿，从大腿后侧轻轻拉向自己，膝盖保持自然伸展。</string>
    <string name="stretch_catalog_inner_thigh_title">坐姿大腿内侧拉伸</string>
    <string name="stretch_catalog_inner_thigh_instruction">坐直并让双脚脚掌相对，放松膝盖向两侧打开，不要用手向下压。</string>
    <string name="stretch_catalog_calf_title">小腿放松</string>
    <string name="stretch_catalog_calf_instruction">指定侧腿向后迈，膝盖自然伸直但不锁死，脚跟保持着地。前侧膝盖轻轻弯曲，需要时可扶稳墙壁或栏杆。</string>
    <string name="stretch_catalog_quad_title">站立大腿前侧拉伸</string>
    <string name="stretch_catalog_quad_instruction">扶稳墙壁或栏杆，弯曲指定侧膝盖，轻轻将脚跟靠近臀部，双膝保持靠近。没有稳固支撑或难以保持平衡时，请跳过。</string>
    <string name="stretch_catalog_hip_flexor_title">跪姿髋屈肌拉伸</string>
    <string name="stretch_catalog_hip_flexor_instruction">跪成前后分腿姿势，轻轻收紧骨盆，保持脊柱自然，再缓缓向前移动。</string>
    <string name="stretch_catalog_standing_hamstring_title">站姿大腿后侧拉伸</string>
    <string name="stretch_catalog_standing_hamstring_instruction">将指定侧脚跟向前迈一小步，脚尖抬起。另一侧膝盖微屈，背部自然伸展，从髋部轻轻前倾，双手扶在屈膝侧大腿上。</string>
    <string name="stretch_catalog_soleus_title">屈膝小腿拉伸</string>
    <string name="stretch_catalog_soleus_instruction">指定侧腿向后迈，脚跟保持着地，双膝自然微屈。身体保持挺直，需要时可扶稳墙壁或栏杆。</string>
    <string name="stretch_catalog_shoulder_title">站姿肩部拉伸</string>
    <string name="stretch_catalog_shoulder_instruction">双脚站稳，将指定侧手臂横放于胸前，另一只手轻扶肘部上方或下方，肩膀保持放松。</string>
    <string name="stretch_catalog_chest_title">站姿扩胸拉伸</string>
    <string name="stretch_catalog_chest_instruction">站直，肩膀轻轻下沉并向后打开，微微抬胸，不要塌腰。</string>
    <string name="stretch_catalog_upper_back_title">上背部拉伸</string>
    <string name="stretch_catalog_upper_back_instruction">双手合拢向前伸，轻轻拱起上背，让肩胛骨向两侧展开，膝盖保持微屈。</string>
    <string name="stretch_catalog_triceps_title">上臂后侧拉伸</string>
    <string name="stretch_catalog_triceps_instruction">一只手臂举过头顶并屈肘，手放在头后；另一只手轻扶肘部上方，不要用力拉，肋骨保持放松。</string>
    <string name="stretch_catalog_lat_title">支撑式背阔肌拉伸</string>
    <string name="stretch_catalog_lat_instruction">双手放在腰部高度的固定稳固台面上，向后退，从髋部前倾，背部保持伸展。没有合适支撑时请跳过。</string>
    <string name="stretch_catalog_wall_side_title">扶墙体侧拉伸</string>
    <string name="stretch_catalog_wall_side_instruction">站在墙边，双手伸向墙面，髋部轻轻向外移，感受体侧温和拉伸，双脚保持着地。</string>
    <string name="stretch_catalog_wall_chest_title">扶墙胸部拉伸</string>
    <string name="stretch_catalog_wall_chest_instruction">一侧前臂贴墙，肘部与肩同高，胸口轻轻转向另一侧，感受温和拉伸。肩膀放松，不要强扭。</string>
    <string name="stretch_catalog_leg_swings_title">前后摆腿</string>
    <string name="stretch_catalog_leg_swings_instruction">扶稳固定支撑物，膝盖微屈，轻轻前后摆动一条腿，保持上身直立。</string>
    <string name="stretch_catalog_lateral_leg_swings_title">侧向摆腿</string>
    <string name="stretch_catalog_lateral_leg_swings_instruction">扶稳固定栏杆，轻轻将一条腿向内、向外摆动，保持骨盆平稳。</string>
    <string name="stretch_catalog_gate_opener_title">开髋抬腿</string>
    <string name="stretch_catalog_gate_opener_instruction">屈膝抬起一条腿，轻轻向外打开大腿，再放下。左右交替，不要扭转支撑腿的膝盖；必要时扶稳支撑物。</string>
    <string name="stretch_catalog_heel_to_toe_rocks_title">脚跟脚尖交替抬起</string>
    <string name="stretch_catalog_heel_to_toe_rocks_instruction">膝盖微屈，轻轻踮起双脚，再放下脚跟，稍稍抬起脚尖。缓慢交替，保持平衡。</string>
    <string name="stretch_catalog_lateral_foot_rocks_title">足底左右移重心</string>
    <string name="stretch_catalog_lateral_foot_rocks_instruction">站立，膝盖微屈，重心在足底小幅左右移动，双脚基本贴地。幅度要小，不要让脚踝向两侧翻倒。</string>
    <string name="stretch_catalog_knee_circles_title">膝部小幅绕圈</string>
    <string name="stretch_catalog_knee_circles_instruction">双脚靠近，膝盖微屈，双手轻放在膝盖上方，舒适地小幅绕圈。双脚不离地，不要用力扭转。</string>
    <string name="stretch_catalog_dynamic_side_bends_title">动态侧屈</string>
    <string name="stretch_catalog_dynamic_side_bends_instruction">站直，膝盖微屈，一只手臂举过头顶，轻轻向侧面弯身。回正后换边，胸口始终朝前。</string>
    <string name="stretch_catalog_split_squats_title">分腿蹲</string>
    <string name="stretch_catalog_split_squats_instruction">一脚在前、一脚在后，屈双膝垂直下蹲，再站起。前膝与脚尖方向一致，下蹲至舒适深度即可。</string>
    <string name="stretch_catalog_dynamic_lateral_lunge_title">动态侧弓步</string>
    <string name="stretch_catalog_dynamic_lateral_lunge_instruction">双脚分开，臀部向后移，屈一侧膝盖，另一腿伸长。回到中间后换边，膝盖与脚尖方向一致。</string>
    <string name="stretch_catalog_runners_lunge_twist_title">跑者弓步转体</string>
    <string name="stretch_catalog_runners_lunge_twist_instruction">迈入跑者弓步，将对侧手放在前脚旁。轻轻朝前膝方向转开胸口，另一手向上伸展。回正后换边，不要强行扭转。</string>
    <string name="stretch_catalog_toe_touch_twist_title">俯身交替转体</string>
    <string name="stretch_catalog_toe_touch_twist_instruction">双脚分开，膝盖微屈，从髋部俯身，一手伸向对侧小腿或脚，另一臂向上打开。经中间回正后换边，不必碰到脚尖。</string>
    <string name="stretch_catalog_high_knee_twists_title">抬膝转体</string>
    <string name="stretch_catalog_high_knee_twists_instruction">站直，抬起一侧膝盖，轻轻朝该侧转动胸口。放下脚、回正，再换边。不要拉扯或按压膝盖。</string>
    <string name="stretch_catalog_dynamic_quad_title">动态大腿前侧拉伸</string>
    <string name="stretch_catalog_dynamic_quad_instruction">站直，短暂握住身后一侧脚踝，双膝靠近，屈膝朝下。松手、迈步，再换边。必要时扶稳支撑物，不要塌腰。</string>
    <string name="stretch_catalog_hamstring_scoops_title">腿后侧扫手伸展</string>
    <string name="stretch_catalog_hamstring_scoops_instruction">一侧脚跟向前点地、脚尖抬起，支撑腿微屈。从髋部俯身，双手沿前腿两侧向下扫过。平稳站起后换边。</string>
    <string name="stretch_catalog_high_knees_title">高抬腿</string>
    <string name="stretch_catalog_high_knees_instruction">原地踏步或轻跑，左右交替抬膝至舒适高度，对侧手臂自然摆动。上身直立、轻柔落地；低抬膝踏步也可以。</string>
    <string name="stretch_catalog_butt_kicks_title">后踢腿</string>
    <string name="stretch_catalog_butt_kicks_instruction">原地踏步或轻跑，左右交替向后抬脚跟，靠近臀部。大腿基本竖直，上身直立、轻柔落地，不必踢到臀部。</string>
    <string name="stretch_catalog_side_lunge_title">侧弓步拉伸</string>
    <string name="stretch_catalog_side_lunge_instruction">双脚分开，屈一侧膝盖，另一腿伸长。臀部向后移，双脚贴地，保持大腿内侧轻柔的牵拉感。</string>
    <string name="stretch_catalog_wide_leg_fold_title">坐姿宽腿前屈</string>
    <string name="stretch_catalog_wide_leg_fold_instruction">坐下，双腿舒适地分开，膝盖放松。从髋部轻轻向前俯身，背部舒展，双手放在身前地面，不要强压胸口向下。</string>
    <string name="stretch_catalog_wide_leg_side_title">宽距站姿侧屈</string>
    <string name="stretch_catalog_wide_leg_side_instruction">双脚分开，膝盖微屈，一手轻放大腿，另一臂举过头顶，轻轻向侧面弯身，胸口保持朝前。</string>
    <string name="stretch_catalog_cross_leg_fold_title">交叉腿前屈</string>
    <string name="stretch_catalog_cross_leg_fold_instruction">一脚交叉放在另一脚前，双脚着地、膝盖微屈。从髋部轻轻俯身，双手伸向小腿。缓慢起身，解开交叉后再换边；必要时扶稳支撑物。</string>
    <string name="stretch_catalog_downward_dog_title">下犬式</string>
    <string name="stretch_catalog_downward_dog_instruction">从四点跪姿开始，脚趾蹬地，臀部向上、向后抬起。膝盖可微屈，让背部舒展，脚跟不必落地。结束时放下双膝。</string>
    <string name="stretch_catalog_pigeon_title">支撑鸽式拉伸</string>
    <string name="stretch_catalog_pigeon_instruction">一侧膝盖放到身前，脚跟靠近对侧腹股沟，另一腿向后伸展。用软垫支撑前侧臀部，髋部朝前，不要强行把小腿摆成直角。膝盖不适时停止，可改做仰卧四字拉伸。</string>
    <string name="stretch_catalog_seated_hamstring_title">坐姿单腿腿后侧拉伸</string>
    <string name="stretch_catalog_seated_hamstring_instruction">坐下，一腿向前伸长、膝盖放松，另一膝向外屈曲，脚底贴住伸直腿的大腿内侧。从髋部轻轻向前俯身。屈腿的脚留在骨盆前方，不要折到身后。</string>
    <string name="stretch_catalog_bent_over_calf_title">俯身小腿拉伸</string>
    <string name="stretch_catalog_bent_over_calf_instruction">一侧脚跟向前点地、脚尖抬起，支撑膝微屈。从髋部轻轻俯身，若能舒适够到，可轻拉前脚掌朝向小腿。不要勉强伸手。</string>
    <string name="stretch_catalog_seated_twist_title">简化坐姿转体</string>
    <string name="stretch_catalog_seated_twist_instruction">坐直，一腿伸长，另一脚放在该腿大腿外侧。将一手放在身后，胸口轻轻转向屈膝侧。另一手轻放大腿，不要用肘部顶压膝盖借力。</string>
