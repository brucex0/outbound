  code          String          @unique
  clickCount    Int             @default(0)
  claimCount    Int             @default(0)
  lastClickedAt DateTime?
  createdAt     DateTime        @default(now())
  claims        ReferralClaim[]
}

model ReferralClaim {
  id                        String       @id @default(cuid())
  referralLinkId            String
  referralLink              ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  claimantId                String       @unique
  claimant                  User         @relation("ReferralClaimant", fields: [claimantId], references: [id], onDelete: Cascade)
  claimedAt                 DateTime     @default(now())
  status                    String       @default("claimed")
  rewardDays                Int          @default(30)
  inviteeRewardDays         Int          @default(30)
  qualifyingActivitySeconds Int          @default(600)
  termsVersion              Int          @default(1)
  qualifiedAt               DateTime?
  rewardedAt                DateTime?

  @@index([referralLinkId, claimedAt])
}

model Follow {
  followerId  String
  followingId String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
}

model Reaction {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      String // fire | clap | heart | strong
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model SocialBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("SocialBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("SocialBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model SocialReport {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  reason     String
  details    String?
  status     String   @default("open")
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

model SocialNotification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   User      @relation("SocialNotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation("SocialNotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        String
  objectId    String?
  message     String
  dedupeKey   String?   @unique
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  appBundle  String
  locale     String?
  enabled    Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, enabled])
}
