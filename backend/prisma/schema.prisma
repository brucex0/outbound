generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model User {
  id                   String    @id @default(cuid())
  firebaseUid          String?   @unique
  normalizedEmail      String?
  normalizedPhone      String?
  username             String    @unique
  usernameChangedAt    DateTime?
  displayName          String
  avatarUrl            String?
  bio                  String?
  contactEmail         String?
  contactPhone         String?
  verified             Boolean   @default(false)
  termsAcceptedVersion Int?
  termsAcceptedAt      DateTime?
  onboardingStatus     String    @default("pending")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  activities                  Activity[]
  authIdentities              AuthIdentity[]
  authSessions                AuthSession[]
  identityLinkIntents         IdentityLinkIntent[]
  activeWorkoutPresence       ActiveWorkoutPresence?
  guideProfile                GuideProfile?
  preferences                 UserPreferences?
  trainingGoals               TrainingGoal[]
  trainingPlans               TrainingPlan[]
  plannedWorkouts             PlannedWorkout[]
  workoutCompletions          WorkoutCompletion[]
  readinessCheckIns           ReadinessCheckIn[]
  athleteTrainingStates       AthleteTrainingState[]
  planningEvents              PlanningEvent[]
  planAdjustmentEvents        PlanAdjustmentEvent[]
  runnerProfile               RunnerProfile?
  calibrationProgram          CalibrationProgram?
  runnerInsights              RunnerInsight[]
  runnerModelVersions         RunnerModelVersion[]
  workoutFeedback             WorkoutFeedback[]
  personalizationAdjustments  PersonalizationAdjustment[]
  runnerEvidence              RunnerEvidence[]
  runnerBeliefs               RunnerBelief[]
  companionEpisodes           CompanionEpisode[]
  companionConversationStates CompanionConversationState[]
  adminRewardAuditEvents      AdminRewardAuditEvent[]
  contextManifests            ContextManifest[]
  situationalSignals          SituationalSignal[]
  agentActions                AgentAction[]
  agentOutcomes               AgentOutcome[]
  safetyLiveShares            SafetyLiveShare[]
  liveShareInvitations        SafetyLiveShareRecipient[]   @relation("LiveShareRecipient")
  liveShareCheersSent         SafetyLiveShareCheer[]       @relation("LiveShareCheerSender")
  liveGroupSessionsCreated    LiveGroupSession[]           @relation("LiveGroupSessionCreator")
  liveGroupParticipants       LiveGroupParticipant[]
  posts                       Post[]
  following                   Follow[]                     @relation("follower")
  followers                   Follow[]                     @relation("following")
  reactions                   Reaction[]
  comments                    Comment[]
  connectionsRequested        Connection[]                 @relation("ConnectionRequester")
  connectionsReceived         Connection[]                 @relation("ConnectionAddressee")
  circlesOwned                Circle[]                     @relation("CircleOwner")
  circleMemberships           CircleMember[]
  primaryCircleId             String?
  primaryCircle               Circle?                      @relation("PrimaryCircle", fields: [primaryCircleId], references: [id], onDelete: SetNull)
  circleInvitationsSent       CircleInvitation[]           @relation("CircleInvitationSender")
  circleInvitationsReceived   CircleInvitation[]           @relation("CircleInvitationRecipient")
  circleCheersSent            CircleCheer[]                @relation("CircleCheerSender")
  circleCheersReceived        CircleCheer[]                @relation("CircleCheerRecipient")
  circleWeekPresentations     CircleWeekPresentation[]
  clubMemberships             ClubMembership[]
  activityEventsCreated       ActivityEvent[]              @relation("ActivityEventCreator")
  invitationsSent             Invitation[]                 @relation("InvitationSender")
  invitationsReceived         Invitation[]                 @relation("InvitationRecipient")
  referralLink                ReferralLink?                @relation("ReferralCreator")
  referralClaim               ReferralClaim?               @relation("ReferralClaimant")
  moments                     Moment[]
  socialBlocksCreated         SocialBlock[]                @relation("SocialBlocker")
  socialBlocksReceived        SocialBlock[]                @relation("SocialBlocked")
  socialReports               SocialReport[]
  socialNotifications         SocialNotification[]         @relation("SocialNotificationRecipient")
  socialNotificationsActed    SocialNotification[]         @relation("SocialNotificationActor")
  pushDevices                 PushDevice[]
  activityEventParticipants   ActivityEventParticipant[]
  routesOwned                 Route[]
  usernameReservations        UsernameReservation[]
  routeBookmarks              RouteBookmark[]
  liveCoachSessions           LiveCoachSession[]
  featureEntitlements         FeatureEntitlement[]
  featureUsagePeriods         FeatureUsagePeriod[]
  entitlementGrantLedger      EntitlementGrantLedger[]
  entitlementCodeRedemptions  EntitlementCodeRedemption[]
  recognitionAwards           RecognitionAward[]

  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_displayName_trgm_idx")
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_username_trgm_idx")
}

model UsernameReservation {
  username  String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model AndroidWaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("marketing_home")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model UserPreferences {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  schemaVersion Int      @default(1)
  data          Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuthIdentity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider        String
  providerSubject String

  email           String?
  normalizedEmail String?
  emailVerified   Boolean @default(false)
  displayName     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([normalizedEmail])
}

model AuthSession {
  id                       String    @id @default(cuid())
  userId                   String
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId                 String
  refreshTokenHash         String    @unique
  previousRefreshTokenHash String?
  platform                 String
  deviceLabel              String?
  createdAt                DateTime  @default(now())
  lastUsedAt               DateTime  @default(now())
  expiresAt                DateTime
  revokedAt                DateTime?

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([previousRefreshTokenHash])
  @@index([expiresAt])
}

model IdentityLinkIntent {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

model ActiveWorkoutPresence {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientSessionId String   @unique
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model GuideProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Guide identity
  guideName      String @default("Guide")
  coachPersonaId String @default("plainstride_supportive_v1")
  voiceProfileId String @default("plainstride_warm_1")

  // Athlete snapshot (rebuilt after each activity)
  fitnessLevel   String   @default("beginner") // beginner | intermediate | advanced | elite
  weeklyVolumeKm Float    @default(0)
  preferredPace  Float? // seconds per km
  strengths      String[] @default([])
  weaknesses     String[] @default([])

  // Goals
  goals Json @default("[]") // GoalItem[]

  // Personal records
  records Json @default("{}") // { "5k": seconds, "10k": seconds, ... }

  // Guidance memory — compressed history for on-device context
  memorySnapshot Json      @default("{}") // last 30 days summary
  lastBuiltAt    DateTime?

  // Downloadable artifact version
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LiveCoachSession {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientSessionId      String
  workoutId            String?
  status               String
  locale               String
  market               String
  coachPersonaId       String
  personaVersion       Int
  voiceProfileId       String
  coachingContract     String
  effectiveAudioMode   String
  configVersion        String
  accessReason         String
  providerKey          String?
  providerEndpointKey  String?
  providerModel        String?
  providerVoice        String?
  routePolicyVersion   String?
  compiledContext      Json
  contextHash          String
  contextVersion       Int
  guidancePlan         Json
  guidancePlanHash     String
  plannerStatus        String
  plannerModel         String?
  plannerPromptVersion String
  dynamicCueLimit      Int
  dynamicCueCount      Int            @default(0)
  expiresAt            DateTime
  endedAt              DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  cues                 LiveCoachCue[]

  @@unique([userId, clientSessionId])
  @@index([userId, status, createdAt])
  @@index([expiresAt])
}

model LiveCoachCue {
  id                String           @id @default(cuid())
  sessionId         String
  session           LiveCoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cueRequestId      String
  moment            String
  source            String
  resultCategory    String
  contextHash       String
  latencyBucket     String?
  inputTokenBucket  String?
  outputAudioBucket String?
  createdAt         DateTime         @default(now())
  expiresAt         DateTime

  @@unique([sessionId, cueRequestId])
  @@index([expiresAt])
}

model FeatureEntitlement {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability          String
  source              String
  status              String
  sourceReferenceHash String?   @unique
  startsAt            DateTime
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, capability, source])
  @@index([userId, capability, status, expiresAt])
}

model FeatureUsagePeriod {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability      String
  periodKey       String
  reservedCount   Int      @default(0)
  successfulCount Int      @default(0)
  limitSnapshot   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, capability, periodKey])
}

model EntitlementCode {
  id              String    @id @default(cuid())
  codeDigest      String    @unique
  label           String
  bundle           String    @default("plus")
  durationDays     Int
  maxRedemptions   Int       @default(1)
  redemptionCount Int       @default(0)
  status           String    @default("active")
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  redemptions      EntitlementCodeRedemption[]
}

model EntitlementCodeRedemption {
  id        String          @id @default(cuid())
  codeId    String
  code      EntitlementCode @relation(fields: [codeId], references: [id], onDelete: Restrict)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([codeId, userId])
  @@index([userId, createdAt])
}

model EntitlementGrantLedger {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability          String
  source              String
  sourceReferenceHash String
  durationDays        Int?
  startsAt            DateTime
  expiresAt           DateTime?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())

  @@unique([userId, capability, sourceReferenceHash])
  @@index([userId, capability, expiresAt])
}

model AdminRewardAuditEvent {
  id            String   @id @default(cuid())
  actorUserId   String
  actor         User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action        String
  targetType    String
  targetId      String
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model FeatureControl {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Activity {
  id               String  @id @default(cuid())
  userId           String
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientActivityId String?
  syncSource       String? // ios-local-store, watch-import, manual

  // Extensible canonical endurance-sport value. Current values are
  // running | cycling | hiking | walking | swimming | strength | mobility.
  type               String
  title              String?
  startedAt          DateTime
  endedAt            DateTime?
  durationSecs       Int?
  distanceM          Float?
  elevationM         Float?
  avgPace            Float? // secs/km
  avgHeartRate       Int?
  energyKilocalories Int?

  // Optional activity companion context. Only "dog" is supported; null means
  // no companion. It records that the person brought a dog and never measures
  // or describes the dog itself.
  companionType      String?

  routeBlob                  Bytes? // Compact versioned route payload; never rewritten with activity metadata
  routeMetadata              Json? // Small route metadata (visibility/elevation attribution)
  splits                     Json? // Split[]
  reflection                 Json? // post-activity finish reflection saved by the client
  clientData                 Json? // lossless client snapshot used to restore local-first history
  clientUpdatedAt            DateTime?
  deletedAt                  DateTime?
  photos                     Photo[]
  posts                      Post[]
  workoutCompletions         WorkoutCompletion[]
  moments                    Moment[]
  activityEventParticipation ActivityEventParticipant?
  circleContributions        CircleContribution[]
  publishedRoute             Route?
  followedRouteId            String?
  followedRoute              Route?                    @relation("FollowedRouteActivities", fields: [followedRouteId], references: [id], onDelete: SetNull)
  routeCompletion            RouteCompletion?

  // AI guide analysis generated after activity
  guideAnalysis Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, clientActivityId])
  @@index([followedRouteId])
}

model RecognitionAward {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId                String
  family                 String
  earnedAt               DateTime
  sourceType             String
  sourceActivityClientId String?
  sourceReferenceId      String?
  ruleVersion            Int      @default(1)
  shareEligible          Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([userId, badgeId])
  @@index([userId, earnedAt])
  @@index([sourceActivityClientId])
}

model Route {
  id               String   @id @default(cuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceActivityId String   @unique
  sourceActivity   Activity @relation(fields: [sourceActivityId], references: [id], onDelete: Restrict)
  name             String
  description      String?
  activityType     String
  visibility       String   @default("public") // public | unlisted | private
  status           String   @default("active") // active | archived
  geometry         Json // share-safe GeoJSON LineString; never contains timestamps
  distanceM        Float
  elevationGainM   Float?
  routeShape       String   @default("point_to_point")
  startLatitude    Float
  startLongitude   Float
  minLatitude      Float
  maxLatitude      Float
  minLongitude     Float
  maxLongitude     Float
  bookmarkCount    Int      @default(0)
  completionCount  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bookmarks          RouteBookmark[]
  followedActivities Activity[]        @relation("FollowedRouteActivities")
  completions        RouteCompletion[]

  @@index([visibility, status, startLatitude, startLongitude])
  @@index([ownerId, updatedAt])
  @@index([activityType, visibility, status])
}

model RouteCompletion {
  id         String   @id @default(cuid())
  routeId    String
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([routeId, createdAt])
}

model RouteBookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, routeId])
  @@index([userId, createdAt])
}

model SafetyLiveShare {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId           String?
  tokenHash            String    @unique
  status               String    @default("active")
  recipientLabel       String?
  sport                String?
  title                String?
  voiceCheerEnabled    Boolean   @default(false)
  startedAt            DateTime  @default(now())
  expiresAt            DateTime
  endedAt              DateTime?
  lastLocationAt       DateTime?
  lastLocation         Json?
  routePreview         Json      @default("[]")
  elapsedSeconds       Int       @default(0)
  distanceM            Float     @default(0)
  currentPaceSecsPerKm Float?
  heartRate            Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  points     SafetyLiveSharePoint[]
  recipients SafetyLiveShareRecipient[]
  cheers     SafetyLiveShareCheer[]

  @@index([userId, status])
  @@index([expiresAt])
}

model SafetyLiveShareRecipient {
  id          String          @id @default(cuid())
  shareId     String
  share       SafetyLiveShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User            @relation("LiveShareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@unique([shareId, recipientId])
  @@index([recipientId, createdAt])
}

model SafetyLiveShareCheer {
  id          String          @id @default(cuid())
  shareId     String
  share       SafetyLiveShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User            @relation("LiveShareCheerSender", fields: [senderId], references: [id], onDelete: Cascade)
  audio       Bytes
  contentType String          @default("audio/mp4")
  durationMs  Int
  createdAt   DateTime        @default(now())
  deliveredAt DateTime?
  playedAt    DateTime?
  acknowledgedAt DateTime?

  @@index([shareId, createdAt])
  @@index([senderId, createdAt])
}

model SafetyLiveSharePoint {
  id             String          @id @default(cuid())
  shareId        String
  share          SafetyLiveShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  recordedAt     DateTime
  latitude       Float
  longitude      Float
  altitudeM      Float?
  accuracyM      Float?
  elapsedSeconds Int
  distanceM      Float
  createdAt      DateTime        @default(now())

  @@index([shareId, recordedAt])
}

model LiveGroupSession {
  id              String    @id @default(cuid())
  creatorUserId   String
  creator         User      @relation("LiveGroupSessionCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  inviteTokenHash String    @unique
  kind            String    @default("group_run")
  status          String    @default("active")
  title           String?
  sport           String?
  startedAt       DateTime  @default(now())
  expiresAt       DateTime
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  participants LiveGroupParticipant[]

  @@index([creatorUserId, status])
  @@index([expiresAt])
}

model LiveGroupParticipant {
  id                   String           @id @default(cuid())
  sessionId            String
  session              LiveGroupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName          String
  status               String           @default("active")
  joinedAt             DateTime         @default(now())
  leftAt               DateTime?
  lastLocationAt       DateTime?
  lastLocation         Json?
  lastActivitySnapshot Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([sessionId, userId])
  @@index([sessionId, status])
  @@index([userId, status])
  @@index([lastLocationAt])
}

model TrainingPlanTemplate {
  id                     String   @id
  focus                  String
  sport                  String
  titleKey               String
  subtitle               String
  defaultWeeks           Int
  minSessionsPerWeek     Int
  maxSessionsPerWeek     Int
  baseWeeklyMinutes      Int
  baseLongSessionMinutes Int
  summary                String
  highlights             String[] @default([])
  source                 Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  weeks TrainingPlanWeek[]

  @@index([focus])
  @@index([sport])
}

model TrainingPlanWeek {
  id         String               @id @default(cuid())
  templateId String
  template   TrainingPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sourceId   String
  weekIndex  Int
  focus      String
  summary    String
  notes      String[]             @default([])
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  workouts TrainingPlanWorkout[]

  @@unique([templateId, sourceId])
  @@unique([templateId, weekIndex])
  @@index([templateId])
}

model TrainingPlanWorkout {
  id              String           @id @default(cuid())
  weekId          String
  week            TrainingPlanWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  sourceId        String
  sortOrder       Int
  title           String
  kind            String
  dayLabel        String
  summary         String
  purpose         String
  guideCue        String?
  effortLabel     String
  durationSeconds Int
  distanceLabel   String?
  isOptional      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  steps TrainingPlanWorkoutStep[]

  @@unique([weekId, sourceId])
  @@index([weekId, sortOrder])
}

model TrainingPlanWorkoutStep {
  id              String              @id @default(cuid())
  workoutId       String
  workout         TrainingPlanWorkout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sourceId        String
  sortOrder       Int
  kind            String
  label           String
  durationSeconds Int
  detail          String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([workoutId, sourceId])
  @@index([workoutId, sortOrder])
}

model TrainingGoal {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 String
  activities           String[]  @default(["run"])
  baselineContext      String    @default("currentlyActive")
  targetDate           DateTime?
  targetDistanceMeters Float?
  targetEventName      String?
  eventIntent          String?
  targetTimeSeconds    Int?
  reviewHorizonWeeks   Int?
  successSignal        String?
  goalDescription      String?
  intakeContextVersion String?
  priority             String
  preferredDays        String[]  @default([])
  preferredLongSessionDay String?
  daysPerWeekTarget    Int       @default(3)
  maxSessionMinutes    Int       @default(45)
  riskTolerance        String    @default("balanced")
  primaryMotivation    String    @default("generalFitness")
  preferredRunGoalType String    @default("time")
  constraints          Json      @default("{}")
  status               String    @default("active")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  plans TrainingPlan[]

  @@index([userId, status])
}

model TrainingPlan {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId       String
  goal         TrainingGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  status       String       @default("active")
  currentPhase String       @default("base")
  source       String       @default("generated")
  startedAt    DateTime     @default(now())
  endedAt      DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  versions TrainingPlanVersion[]

  @@index([userId, status])
  @@index([goalId])
}

model TrainingPlanVersion {
  id             String       @id @default(cuid())
  planId         String
  plan           TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  versionNumber  Int
  reason         String
  effectiveFrom  DateTime     @default(now())
  effectiveUntil DateTime?
  summary        String
  engineInputs   Json         @default("{}")
  engineDecision Json         @default("{}")
  createdAt      DateTime     @default(now())

  workouts PlannedWorkout[]

  @@unique([planId, versionNumber])
  @@index([planId, createdAt])
}

model PlannedWorkout {
  id                String              @id @default(cuid())
  planVersionId     String
  planVersion       TrainingPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledDate     DateTime
  modality          String
  stimulus          String
  title             String
  durationSeconds   Int
