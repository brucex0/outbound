{
  "name": "outbound-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch dist/index.js",
    "start:local": "npm run build && node scripts/start-local-stack.mjs",
    "start": "node dist/index.js",
    "load:smoke": "node scripts/load-smoke.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "node dist/scripts/prepareActivityRouteStorage.js && prisma db push --skip-generate",
    "db:rebuild": "prisma db push --force-reset && prisma generate && npm run build && npm run seed:training-plans",
    "migrate:activity-client-data": "npm run build && node dist/scripts/migrateActivityClientData.js",
    "migrate:activity-routes": "npm run build && node dist/scripts/migrateActivityRoutes.js",
    "seed:training-plans": "node dist/scripts/seedTrainingPlanTemplates.js",
    "seed:e2e": "npm run build && node dist/scripts/seedTestPersonas.js",
    "planning:maintenance": "node dist/scripts/runPlanningMaintenance.js",
    "rewards:issue-code": "npm run build && node dist/scripts/issueEntitlementCode.js",
    "live-coach:list-audio": "npm run build && node dist/scripts/generateLiveCoachAudio.js --list",
    "live-coach:generate-audio": "npm run build && node dist/scripts/generateLiveCoachAudio.js",
    "live-coach:review-audio": "npm run build && node dist/scripts/reviewLiveCoachAudio.js",
    "live-coach:publish-audio": "npm run build && node dist/scripts/publishLiveCoachAudio.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@google-cloud/text-to-speech": "^7.0.0",
    "@google/genai": "^2.19.0",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "@prisma/client": "^5.22.0",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^11.0.2",
    "hono": "^4.6.0",
    "node-fetch": "^3.3.2",
    "pngjs": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pngjs": "^6.0.5",
    "embedded-postgres": "^18.3.0-beta.17",
    "prisma": "^5.22.0",
    "typescript": "^5.6.0"
  }
}
