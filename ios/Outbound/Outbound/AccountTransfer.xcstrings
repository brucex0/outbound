{
  "sourceLanguage" : "en",
  "strings" : {
    "account_transfer.code_header" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Transfer code" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Código de transferencia" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "转移码" } } } },
    "account_transfer.copied" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Code copied" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Código copiado" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "转移码已复制" } } } },
    "account_transfer.copy" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy code" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Copiar código" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制转移码" } } } },
    "account_transfer.create" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Create transfer code" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Crear código de transferencia" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "创建转移码" } } } },
    "account_transfer.error_message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The transfer code could not be created. Try again." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo crear el código de transferencia. Inténtalo de nuevo." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法创建转移码，请重试。" } } } },
    "account_transfer.error_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn’t create code" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo crear el código" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法创建转移码" } } } },
    "account_transfer.explanation" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Use this on your Android phone to connect Google sign-in to this Plainstride account. Your activities and profile stay with this account." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Úsalo en tu teléfono Android para conectar el acceso con Google a esta cuenta de Plainstride. Tus actividades y tu perfil permanecerán en esta cuenta." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在安卓手机上使用此功能，将 Google 登录关联到当前平步青云账号。你的活动和个人资料会保留在此账号中。" } } } },
    "account_transfer.expiry" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Expires in 10 minutes and works once." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Caduca en 10 minutos y solo se puede usar una vez." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "转移码将在 10 分钟后过期，且仅可使用一次。" } } } },
    "account_transfer.ok" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "OK" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Aceptar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "好" } } } },
    "account_transfer.replace" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Create a new code" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Crear otro código" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "创建新转移码" } } } },
    "account_transfer.security_note" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Only share this code with a device you control. Creating a new code disables the previous one." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Comparte este código solo con un dispositivo que controles. Al crear otro código, el anterior deja de funcionar." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅在你自己的设备上使用此转移码。创建新转移码后，之前的转移码将立即失效。" } } } },
    "account_transfer.settings_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Use account on Android" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Usar la cuenta en Android" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在安卓设备上使用此账号" } } } },
    "account_transfer.share" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Share secure link" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Compartir enlace seguro" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "分享安全链接" } } } },
