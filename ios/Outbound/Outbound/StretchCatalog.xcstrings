{
  "sourceLanguage": "en",
  "strings": {
    "stretch.catalog.movement.glute.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclining glute stretch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento de glúteos tumbado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仰卧臀部拉伸"
          }
        }
      }
    },
    "stretch.catalog.movement.glute.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your back, cross one ankle over the opposite thigh, and draw your legs gently toward your chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Túmbate boca arriba, cruza un tobillo sobre el muslo contrario y acerca suavemente las piernas al pecho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仰卧，将一侧脚踝搭在另一侧大腿上，再轻轻把双腿拉向胸前。"
          }
        }
      }
    },
    "stretch.catalog.movement.hamstring.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying hamstring stretch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento de isquiotibiales tumbado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仰卧大腿后侧拉伸"
          }
        }
      }
    },
    "stretch.catalog.movement.hamstring.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie back and raise one leg. Hold behind the thigh and gently draw it toward you, keeping the knee softly straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Túmbate y eleva una pierna. Sujétala por detrás del muslo y acércala suavemente, manteniendo la rodilla ligeramente extendida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仰卧抬起一条腿，从大腿后侧轻轻拉向自己，膝盖保持自然伸展。"
          }
        }
      }
    },
    "stretch.catalog.movement.inner_thigh.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seated inner-thigh stretch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento sentado de la cara interna del muslo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐姿大腿内侧拉伸"
          }
        }
      }
    },
    "stretch.catalog.movement.inner_thigh.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit tall with the soles of your feet together. Let your knees relax outward without pushing them down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate con la espalda erguida y las plantas de los pies juntas. Deja que las rodillas se abran sin empujarlas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐直并让双脚脚掌相对，放松膝盖向两侧打开，不要用手向下压。"
          }
        }
      }
    },
    "stretch.catalog.movement.calf.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calf release"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento de pantorrilla"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小腿放松"
          }
        }
      }
    },
    "stretch.catalog.movement.calf.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step the named leg back, keep that knee straight without locking it, and its heel down. Bend the front knee gently. Use a stable wall or railing if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva atrás la pierna indicada, con la rodilla extendida sin bloquearla y el talón apoyado. Flexiona suavemente la rodilla delantera. Usa una pared o barandilla firme si lo necesitas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指定侧腿向后迈，膝盖自然伸直但不锁死，脚跟保持着地。前侧膝盖轻轻弯曲，需要时可扶稳墙壁或栏杆。"
          }
        }
      }
    },
    "stretch.catalog.movement.quad.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing quad stretch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuádriceps de pie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站立大腿前侧拉伸"
          }
        }
      }
    },
    "stretch.catalog.movement.quad.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a stable wall or railing. Bend the named knee and gently bring that heel toward your bottom, keeping knees close. Skip if support is unavailable or balance feels difficult."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujétate a una pared o barandilla firme. Flexiona la rodilla indicada y acerca suavemente el talón al glúteo, manteniendo las rodillas juntas. Omite el movimiento si no tienes apoyo o te cuesta mantener el equilibrio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扶稳墙壁或栏杆，弯曲指定侧膝盖，轻轻将脚跟靠近臀部，双膝保持靠近。没有稳固支撑或难以保持平衡时，请跳过。"
          }
        }
      }
    },
    "stretch.catalog.movement.hip_flexor.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kneeling hip-flexor stretch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento de flexores de cadera de rodillas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跪姿髋屈肌拉伸"
          }
        }
      }
    },
    "stretch.catalog.movement.hip_flexor.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kneel in a split stance, gently tuck your pelvis, and keep your spine neutral as you shift forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colócate de rodillas en posición de zancada, bascula suavemente la pelvis y mantén la espalda neutra al avanzar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跪成前后分腿姿势，轻轻收紧骨盆，保持脊柱自然，再缓缓向前移动。"
          }
        }
      }
    },
    "stretch.catalog.movement.standing_hamstring.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing hamstring stretch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento de isquiotibiales de pie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站姿大腿后侧拉伸"
          }
        }
      }
    },
    "stretch.catalog.movement.standing_hamstring.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place the named heel a short step forward with toes up. Bend the other knee and hinge gently at the hips with a long back; rest hands on the bent thigh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adelanta un poco el talón del lado indicado y eleva los dedos. Flexiona la otra rodilla e inclínate suavemente desde las caderas, con la espalda alargada y las manos sobre el muslo flexionado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指定侧脚跟向前迈一小步，脚尖抬起。另一侧膝盖微屈，背部自然伸展，从髋部轻轻前倾，双手扶在屈膝侧大腿上。"
          }
        }
      }
    },
    "stretch.catalog.movement.soleus.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bent-knee calf stretch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento de pantorrilla con rodilla flexionada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屈膝小腿拉伸"
          }
        }
      }
    },
    "stretch.catalog.movement.soleus.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step the named leg back, keep its heel down, and soften both knees. Stay upright and use a stable wall or railing if you need balance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva atrás la pierna indicada, mantén el talón apoyado y flexiona suavemente ambas rodillas. Mantente erguido y usa una pared o barandilla firme si necesitas equilibrio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指定侧腿向后迈，脚跟保持着地，双膝自然微屈。身体保持挺直，需要时可扶稳墙壁或栏杆。"
          }
        }
      }
    },
    "stretch.catalog.movement.shoulder.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing shoulder stretch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento de hombro de pie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站姿肩部拉伸"
          }
        }
      }
    },
    "stretch.catalog.movement.shoulder.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand with both feet grounded. Bring the named arm across your chest and gently support it above or below the elbow; keep the shoulder relaxed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoya ambos pies. Cruza el brazo indicado por delante del pecho y sujétalo suavemente por encima o debajo del codo, manteniendo el hombro relajado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双脚站稳，将指定侧手臂横放于胸前，另一只手轻扶肘部上方或下方，肩膀保持放松。"
          }
        }
      }
    },
    "stretch.catalog.movement.chest.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing chest opener"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apertura de pecho de pie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站姿扩胸拉伸"
          }
        }
      }
    },
    "stretch.catalog.movement.chest.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand tall, draw your shoulders gently down and back, and lift your chest slightly without arching your lower back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte de pie, lleva suavemente los hombros hacia abajo y atrás y eleva un poco el pecho sin arquear la zona lumbar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站直，肩膀轻轻下沉并向后打开，微微抬胸，不要塌腰。"
          }
        }
      }
    },
    "stretch.catalog.movement.upper_back.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upper-back stretch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento de espalda alta"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上背部拉伸"
          }
        }
      }
    },
    "stretch.catalog.movement.upper_back.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach both arms forward with hands together. Gently round your upper back and let your shoulder blades move apart; keep your knees soft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extiende los brazos al frente con las manos juntas. Redondea suavemente la espalda alta y separa los omóplatos; mantén las rodillas relajadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双手合拢向前伸，轻轻拱起上背，让肩胛骨向两侧展开，膝盖保持微屈。"
          }
        }
      }
    },
    "stretch.catalog.movement.triceps.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overhead triceps stretch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento de tríceps por encima de la cabeza"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上臂后侧拉伸"
          }
        }
      }
    },
    "stretch.catalog.movement.triceps.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise one arm and bend the elbow so your hand rests behind your head. Rest the other hand above that elbow and apply only gentle pressure; keep your ribs relaxed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva un brazo y dobla el codo, dejando la mano detrás de la cabeza. Apoya la otra mano por encima del codo y presiona suavemente, sin sacar las costillas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一只手臂举过头顶并屈肘，手放在头后；另一只手轻扶肘部上方，不要用力拉，肋骨保持放松。"
          }
        }
      }
    },
    "stretch.catalog.movement.lat.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported lat stretch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento dorsal con apoyo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支撑式背阔肌拉伸"
          }
        }
      }
    },
    "stretch.catalog.movement.lat.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place both hands on a fixed, sturdy surface around waist height. Step back and hinge at your hips, keeping your back long. Skip if suitable support is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoya las manos en una superficie fija y firme a la altura de la cintura. Da un paso atrás e inclínate desde las caderas, manteniendo la espalda alargada. Omítelo si no tienes un apoyo adecuado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双手放在腰部高度的固定稳固台面上，向后退，从髋部前倾，背部保持伸展。没有合适支撑时请跳过。"
          }
        }
      }
    },
    "stretch.catalog.movement.wall_side.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wall side stretch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento lateral con pared"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扶墙体侧拉伸"
          }
        }
      }
    },
    "stretch.catalog.movement.wall_side.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand beside a wall. Reach both hands toward it and gently lean your hips away until you feel a mild stretch along your side. Keep both feet grounded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colócate junto a una pared, lleva ambas manos hacia ella y aleja suavemente las caderas hasta sentir una tensión leve en el costado. Mantén los pies apoyados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站在墙边，双手伸向墙面，髋部轻轻向外移，感受体侧温和拉伸，双脚保持着地。"
          }
        }
      }
    },
    "stretch.catalog.movement.wall_chest.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wall chest stretch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento de pecho en pared"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扶墙胸部拉伸"
          }
        }
      }
    },
    "stretch.catalog.movement.wall_chest.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place one forearm against a wall with the elbow at shoulder height. Turn your chest gently away until you feel a mild stretch. Keep the shoulder relaxed; do not force the turn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoya un antebrazo en la pared con el codo a la altura del hombro. Gira suavemente el pecho en sentido contrario hasta notar una tensión leve. Relaja el hombro y no fuerces el giro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一侧前臂贴墙，肘部与肩同高，胸口轻轻转向另一侧，感受温和拉伸。肩膀放松，不要强扭。"
          }
        }
      }
    },
    "stretch.catalog.movement.leg_swings.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg swings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前后摆腿"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Balanceos de pierna"
          }
        }
      }
    },
    "stretch.catalog.movement.leg_swings.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a fixed support. Swing one leg gently forward and back with a soft knee, keeping your torso tall."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扶稳固定支撑物，膝盖微屈，轻轻前后摆动一条腿，保持上身直立。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujétate a un apoyo fijo. Balancea una pierna suavemente hacia delante y atrás, con la rodilla relajada y el tronco erguido."
          }
        }
      }
    },
    "stretch.catalog.movement.lateral_leg_swings.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lateral leg swings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧向摆腿"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Balanceos laterales de pierna"
          }
        }
      }
    },
    "stretch.catalog.movement.lateral_leg_swings.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a fixed rail. Swing one leg gently across and out to the side while keeping your pelvis level."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扶稳固定栏杆，轻轻将一条腿向内、向外摆动，保持骨盆平稳。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujétate a una barandilla fija. Balancea una pierna suavemente hacia dentro y hacia fuera, manteniendo la pelvis nivelada."
          }
        }
      }
    },
    "stretch.catalog.movement.gate_opener.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gate opener"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开髋抬腿"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apertura de cadera"
          }
        }
      }
    },
    "stretch.catalog.movement.gate_opener.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift one bent knee, open the thigh gently to the side, then lower it. Alternate legs without twisting the planted knee. Use support if needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屈膝抬起一条腿，轻轻向外打开大腿，再放下。左右交替，不要扭转支撑腿的膝盖；必要时扶稳支撑物。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva una rodilla flexionada, abre suavemente el muslo hacia un lado y baja el pie. Alterna sin torcer la rodilla de apoyo. Usa un apoyo si lo necesitas."
          }
        }
      }
    },
    "stretch.catalog.movement.heel_to_toe_rocks.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heel-to-toe rocks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚跟脚尖交替抬起"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Balanceo de talones a puntas"
          }
        }
      }
    },
    "stretch.catalog.movement.heel_to_toe_rocks.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With soft knees, rise gently onto the balls of both feet. Lower your heels, then lift your toes slightly. Rock slowly without losing balance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "膝盖微屈，轻轻踮起双脚，再放下脚跟，稍稍抬起脚尖。缓慢交替，保持平衡。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con las rodillas relajadas, eleva suavemente ambos talones. Bájalos y levanta un poco las puntas. Alterna despacio sin perder el equilibrio."
          }
        }
      }
    },
    "stretch.catalog.movement.lateral_foot_rocks.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lateral foot rocks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "足底左右移重心"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Balanceo lateral de los pies"
          }
        }
      }
    },
    "stretch.catalog.movement.lateral_foot_rocks.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand with soft knees. Shift weight a little across the soles from side to side, keeping feet nearly flat. Keep the range small; do not roll onto your ankles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站立，膝盖微屈，重心在足底小幅左右移动，双脚基本贴地。幅度要小，不要让脚踝向两侧翻倒。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie con las rodillas relajadas, desplaza un poco el peso de un lado a otro de las plantas, con los pies casi planos. Evita volcar los tobillos."
          }
        }
      }
    },
    "stretch.catalog.movement.knee_circles.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knee circles"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "膝部小幅绕圈"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Círculos suaves de rodillas"
          }
        }
      }
    },
    "stretch.catalog.movement.knee_circles.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring feet close and soften your knees. Rest hands lightly above the knees and make tiny comfortable circles. Keep feet planted and never force rotation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双脚靠近，膝盖微屈，双手轻放在膝盖上方，舒适地小幅绕圈。双脚不离地，不要用力扭转。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca los pies y flexiona un poco las rodillas. Apoya las manos suavemente por encima de ellas y haz círculos pequeños y cómodos, sin mover los pies ni forzar el giro."
          }
        }
      }
    },
    "stretch.catalog.movement.dynamic_side_bends.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic side bends"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动态侧屈"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexiones laterales dinámicas"
          }
        }
      }
    },
    "stretch.catalog.movement.dynamic_side_bends.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand tall with soft knees. Reach one arm overhead and bend gently sideways. Return upright and alternate, keeping your chest facing forward."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站直，膝盖微屈，一只手臂举过头顶，轻轻向侧面弯身。回正后换边，胸口始终朝前。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie con las rodillas relajadas, eleva un brazo y flexiona suavemente el tronco hacia un lado. Vuelve al centro y alterna, con el pecho hacia delante."
          }
        }
      }
    },
    "stretch.catalog.movement.split_squats.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split squats"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分腿蹲"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentadillas en posición dividida"
          }
        }
      }
    },
    "stretch.catalog.movement.split_squats.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set one foot forward and the other back. Bend both knees to lower straight down, then rise. Keep the front knee tracking its toes and use a comfortable depth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一脚在前、一脚在后，屈双膝垂直下蹲，再站起。前膝与脚尖方向一致，下蹲至舒适深度即可。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca un pie delante y otro detrás. Flexiona ambas rodillas para bajar verticalmente y vuelve a subir. Alinea la rodilla delantera con los dedos y baja solo hasta donde resulte cómodo."
          }
        }
      }
    },
    "stretch.catalog.movement.dynamic_lateral_lunge.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lateral lunge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动态侧弓步"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zancada lateral"
          }
        }
      }
    },
    "stretch.catalog.movement.dynamic_lateral_lunge.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand wide. Sit your hips back over one bent knee while the other leg stays long. Return to the middle and alternate, with knees tracking toes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双脚分开，臀部向后移，屈一侧膝盖，另一腿伸长。回到中间后换边，膝盖与脚尖方向一致。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa los pies. Lleva las caderas atrás y flexiona una rodilla mientras la otra pierna queda larga. Vuelve al centro y alterna, alineando las rodillas con los pies."
          }
        }
      }
    },
    "stretch.catalog.movement.runners_lunge_twist.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runner’s lunge twist"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跑者弓步转体"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zancada de corredor con giro"
          }
        }
      }
    },
    "stretch.catalog.movement.runners_lunge_twist.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step into a runner’s lunge and place the opposite hand beside the front foot. Gently open your chest toward the front knee and reach up. Return and alternate sides without forcing the twist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "迈入跑者弓步，将对侧手放在前脚旁。轻轻朝前膝方向转开胸口，另一手向上伸展。回正后换边，不要强行扭转。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopta una zancada de corredor y apoya la mano contraria junto al pie delantero. Abre suavemente el pecho hacia la rodilla y eleva el otro brazo. Vuelve y alterna sin forzar el giro."
          }
        }
      }
    },
    "stretch.catalog.movement.toe_touch_twist.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toe touch twist"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "俯身交替转体"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Giro con alcance al pie"
          }
        }
      }
    },
    "stretch.catalog.movement.toe_touch_twist.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand wide with soft knees. Hinge at the hips and reach toward the opposite shin or foot as the other arm opens upward. Return through the middle and alternate. Touching the toes is optional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双脚分开，膝盖微屈，从髋部俯身，一手伸向对侧小腿或脚，另一臂向上打开。经中间回正后换边，不必碰到脚尖。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa los pies y relaja las rodillas. Inclínate desde las caderas y alcanza la espinilla o el pie contrario mientras abres el otro brazo hacia arriba. Vuelve al centro y alterna; no es necesario tocar los dedos."
          }
        }
      }
    },
    "stretch.catalog.movement.high_knee_twists.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High knee twists"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬膝转体"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevación de rodillas con giro"
          }
        }
      }
    },
    "stretch.catalog.movement.high_knee_twists.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand tall. Lift one knee and turn your chest gently toward it. Lower the foot, face forward and alternate. Do not pull or press on the knee."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站直，抬起一侧膝盖，轻轻朝该侧转动胸口。放下脚、回正，再换边。不要拉扯或按压膝盖。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, eleva una rodilla y gira suavemente el pecho hacia ella. Baja el pie, vuelve al frente y alterna. No tires de la rodilla ni la presiones."
          }
        }
      }
    },
    "stretch.catalog.movement.dynamic_quad.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic quad stretch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动态大腿前侧拉伸"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento dinámico de cuádriceps"
          }
        }
      }
    },
    "stretch.catalog.movement.dynamic_quad.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand tall and briefly hold one ankle behind you, with the knee pointing down beside the other knee. Release, step and alternate. Use a fixed support if needed; do not arch your back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站直，短暂握住身后一侧脚踝，双膝靠近，屈膝朝下。松手、迈步，再换边。必要时扶稳支撑物，不要塌腰。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, sujeta brevemente un tobillo por detrás, con la rodilla hacia abajo junto a la otra. Suelta, da un paso y alterna. Usa un apoyo fijo si hace falta y evita arquear la espalda."
          }
        }
      }
    },
    "stretch.catalog.movement.hamstring_scoops.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hamstring scoops"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "腿后侧扫手伸展"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barridos de isquiotibiales"
          }
        }
      }
    },
    "stretch.catalog.movement.hamstring_scoops.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step one heel forward with toes raised. Soften the supporting knee, hinge from your hips and sweep your hands down beside the front leg. Rise smoothly and alternate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一侧脚跟向前点地、脚尖抬起，支撑腿微屈。从髋部俯身，双手沿前腿两侧向下扫过。平稳站起后换边。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adelanta un talón con la punta elevada. Flexiona un poco la pierna de apoyo, inclínate desde las caderas y barre con las manos junto a la pierna delantera. Incorpórate suavemente y alterna."
          }
        }
      }
    },
    "stretch.catalog.movement.high_knees.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High knees"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高抬腿"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodillas arriba"
          }
        }
      }
    },
    "stretch.catalog.movement.high_knees.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "March or jog lightly in place, alternating knees at a comfortable height and swinging opposite arms. Stay upright and land softly. A low march is fine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原地踏步或轻跑，左右交替抬膝至舒适高度，对侧手臂自然摆动。上身直立、轻柔落地；低抬膝踏步也可以。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcha o trota suavemente en el sitio, elevando las rodillas a una altura cómoda y moviendo los brazos contrarios. Mantente erguido y aterriza suave; puedes marchar sin elevar mucho las rodillas."
          }
        }
      }
    },
    "stretch.catalog.movement.butt_kicks.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Butt kicks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后踢腿"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Talones a glúteos"
          }
        }
      }
    },
    "stretch.catalog.movement.butt_kicks.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "March or jog lightly in place, alternating heels toward your buttocks. Keep thighs near vertical, torso tall and land softly. Do not force heel contact."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原地踏步或轻跑，左右交替向后抬脚跟，靠近臀部。大腿基本竖直，上身直立、轻柔落地，不必踢到臀部。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcha o trota suavemente en el sitio, llevando los talones hacia los glúteos de forma alterna. Mantén los muslos casi verticales y aterriza suave, sin forzar el contacto."
          }
        }
      }
    },
    "stretch.catalog.movement.side_lunge.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Side lunge stretch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧弓步拉伸"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento en zancada lateral"
          }
        }
      }
    },
    "stretch.catalog.movement.side_lunge.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand wide and bend one knee while keeping the other leg long. Sit your hips back, keep feet planted and hold gentle tension along the inner thigh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双脚分开，屈一侧膝盖，另一腿伸长。臀部向后移，双脚贴地，保持大腿内侧轻柔的牵拉感。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa los pies y flexiona una rodilla mientras la otra pierna queda larga. Lleva las caderas atrás, mantén los pies apoyados y siente una tensión suave en la cara interna del muslo."
          }
        }
      }
    },
    "stretch.catalog.movement.wide_leg_fold.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seated wide-leg fold"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐姿宽腿前屈"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexión sentada con piernas separadas"
          }
        }
      }
    },
    "stretch.catalog.movement.wide_leg_fold.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit with legs comfortably apart and knees soft. Hinge gently forward from your hips with a long back, resting hands on the floor in front. Do not force your chest down."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐下，双腿舒适地分开，膝盖放松。从髋部轻轻向前俯身，背部舒展，双手放在身前地面，不要强压胸口向下。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate con las piernas separadas cómodamente y las rodillas relajadas. Inclínate suavemente desde las caderas con la espalda larga y apoya las manos delante. No fuerces el pecho hacia abajo."
          }
        }
      }
    },
    "stretch.catalog.movement.wide_leg_side.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wide-leg side bend"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽距站姿侧屈"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexión lateral con piernas separadas"
          }
        }
      }
    },
    "stretch.catalog.movement.wide_leg_side.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand wide with soft knees. Rest one hand on the thigh, reach the other arm overhead and bend gently sideways. Keep your chest facing forward."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双脚分开，膝盖微屈，一手轻放大腿，另一臂举过头顶，轻轻向侧面弯身，胸口保持朝前。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa los pies y relaja las rodillas. Apoya una mano en el muslo, eleva el otro brazo y flexiona suavemente el tronco hacia un lado, con el pecho hacia delante."
          }
        }
      }
    },
    "stretch.catalog.movement.cross_leg_fold.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross-leg fold"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交叉腿前屈"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexión con piernas cruzadas"
          }
        }
      }
    },
    "stretch.catalog.movement.cross_leg_fold.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross one foot in front with both feet grounded and knees soft. Hinge gently from your hips toward your shins. Rise slowly and uncross before changing sides. Use support for balance if needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一脚交叉放在另一脚前，双脚着地、膝盖微屈。从髋部轻轻俯身，双手伸向小腿。缓慢起身，解开交叉后再换边；必要时扶稳支撑物。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruza un pie por delante, con ambos apoyados y las rodillas relajadas. Inclínate suavemente desde las caderas hacia las espinillas. Sube despacio y descruza antes de cambiar. Usa un apoyo si hace falta."
          }
        }
      }
    },
    "stretch.catalog.movement.downward_dog.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downward dog"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下犬式"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perro boca abajo"
          }
        }
      }
    },
    "stretch.catalog.movement.downward_dog.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From hands and knees, tuck your toes and lift hips up and back. Keep knees softly bent to lengthen your back. Heels may stay lifted. Lower your knees to finish."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从四点跪姿开始，脚趾蹬地，臀部向上、向后抬起。膝盖可微屈，让背部舒展，脚跟不必落地。结束时放下双膝。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde cuatro apoyos, apoya los dedos de los pies y eleva las caderas arriba y atrás. Flexiona un poco las rodillas para alargar la espalda; los talones pueden quedar elevados. Baja las rodillas para terminar."
          }
        }
      }
    },
    "stretch.catalog.movement.pigeon.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported pigeon stretch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支撑鸽式拉伸"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento de paloma con apoyo"
          }
        }
      }
    },
    "stretch.catalog.movement.pigeon.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring one knee forward with the heel toward the opposite groin, and extend the other leg behind. Support the front-side hip with a cushion. Keep hips facing forward without forcing the shin square. Stop for knee discomfort; use lying figure four instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一侧膝盖放到身前，脚跟靠近对侧腹股沟，另一腿向后伸展。用软垫支撑前侧臀部，髋部朝前，不要强行把小腿摆成直角。膝盖不适时停止，可改做仰卧四字拉伸。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva una rodilla delante con el talón hacia la ingle contraria y extiende la otra pierna atrás. Apoya la cadera delantera sobre un cojín. Mantén las caderas al frente sin forzar la espinilla. Si molesta la rodilla, cambia al estiramiento de figura cuatro tumbado."
          }
        }
      }
    },
    "stretch.catalog.movement.seated_hamstring.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seated hamstring stretch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐姿单腿腿后侧拉伸"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento de isquiotibiales sentado"
          }
        }
      }
    },
    "stretch.catalog.movement.seated_hamstring.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit with one leg extended and its knee soft. Bend the other knee out with its sole against the inner thigh. Hinge gently toward the long leg. Keep the bent foot in front of your pelvis, never tucked behind."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐下，一腿向前伸长、膝盖放松，另一膝向外屈曲，脚底贴住伸直腿的大腿内侧。从髋部轻轻向前俯身。屈腿的脚留在骨盆前方，不要折到身后。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate con una pierna extendida y la rodilla relajada. Flexiona la otra hacia fuera, con la planta contra la cara interna del muslo. Inclínate suavemente hacia la pierna larga. Mantén el pie flexionado delante de la pelvis, nunca detrás."
          }
        }
      }
    },
    "stretch.catalog.movement.bent_over_calf.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bent-over calf stretch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "俯身小腿拉伸"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiramiento de gemelo inclinado"
          }
        }
      }
    },
    "stretch.catalog.movement.bent_over_calf.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place one heel forward with toes raised and soften the supporting knee. Hinge gently from your hips and, if comfortable, lightly draw the front forefoot toward your shin. Do not force the reach."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一侧脚跟向前点地、脚尖抬起，支撑膝微屈。从髋部轻轻俯身，若能舒适够到，可轻拉前脚掌朝向小腿。不要勉强伸手。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adelanta un talón con la punta elevada y flexiona un poco la rodilla de apoyo. Inclínate suavemente desde las caderas y, si llegas con comodidad, acerca un poco el antepié hacia la espinilla. No fuerces el alcance."
          }
        }
      }
    },
    "stretch.catalog.movement.seated_twist.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modified seated twist"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "简化坐姿转体"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Giro sentado modificado"
          }
        }
      }
    },
    "stretch.catalog.movement.seated_twist.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit tall with one leg long and the opposite foot flat outside its thigh. Place one hand behind you and turn your chest gently toward the bent knee. Rest the other hand lightly on the thigh; do not lever against the knee."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐直，一腿伸长，另一脚放在该腿大腿外侧。将一手放在身后，胸口轻轻转向屈膝侧。另一手轻放大腿，不要用肘部顶压膝盖借力。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate erguido con una pierna larga y el pie contrario apoyado fuera del muslo. Coloca una mano detrás y gira suavemente el pecho hacia la rodilla flexionada. Apoya la otra mano en el muslo sin hacer palanca contra la rodilla."
          }
        }
      }
    },
