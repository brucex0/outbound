    "NSAppleMusicUsageDescription" : {
      "comment" : "Privacy - Media Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride uses Apple Music to play music during workouts and keep your running experience in one place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride usa Apple Music para reproducir música durante los entrenamientos y mantener tu experiencia de running en un solo lugar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride 使用 Apple Music 在训练期间播放音乐，让你的跑步体验集中在一处。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride keeps the camera ready so you can capture moments during your run without leaving the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride mantiene la cámara lista para que puedas capturar momentos durante tu carrera sin salir de la app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride 会准备好相机，让你无需离开应用即可记录跑步中的精彩时刻。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride reads heart rate and workout data from Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride lee datos de frecuencia cardíaca y entrenamientos de Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride 会从 Apple 健康读取心率和训练数据。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride saves your workouts to Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride guarda tus entrenamientos en Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride 会将你的训练存储到 Apple 健康。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride tracks your route during activities, even in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride registra tu ruta durante las actividades, incluso en segundo plano."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride 会在活动期间记录你的路线，即使应用在后台运行也是如此。"
          }
        }
      }
    },
    "NSLocationAlwaysUsageDescription" : {
      "comment" : "Privacy - Location Always Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride tracks your route during activities, even in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride registra tu ruta durante las actividades, incluso en segundo plano."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride 会在活动期间记录你的路线，即使应用在后台运行也是如此。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride uses your approximate location for local running conditions and precise location when tracking a run."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride usa tu ubicación aproximada para mostrar las condiciones locales y tu ubicación precisa al registrar una carrera."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride 使用你的大致位置提供本地跑步条件，并在记录跑步时使用精确位置。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride uses the microphone for voice activity commands and coach audio during workouts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride usa el micrófono para comandos de actividad por voz y el audio del entrenador durante los entrenamientos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride 使用麦克风接收语音活动指令，并在训练期间播放教练音频。"
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride uses motion sensors to improve pace and cadence tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride usa los sensores de movimiento para mejorar el registro del ritmo y la cadencia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride 使用运动传感器来提高配速和步频记录的准确性。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride uses speech recognition to turn short voice commands into prepared activities."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride usa el reconocimiento de voz para convertir comandos breves en actividades preparadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainstride 使用语音识别将简短的语音指令转换为准备好的活动。"
          }
        }
      }
    }
  },
  "version" : "1.0"
