  "strings": {
    "Leave this group?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave this group?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Salir de este grupo?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要退出此群组吗？"
          }
        }
      }
    },
    "Leave group": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave group"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir del grupo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出群组"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "es": {
          "stringUnit": {
