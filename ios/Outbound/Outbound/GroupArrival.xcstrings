            "value": "Opciones del grupo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组选项"
          }
        }
      }
    },
    "You’ll lose access to group content and leave upcoming group activities. Your personal recordings will be kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll lose access to group content and leave upcoming group activities. Your personal recordings will be kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perderás el acceso al contenido del grupo y dejarás de participar en sus próximas actividades. Tus actividades personales se conservarán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出后将无法访问群组内容，并退出尚未开始的群组活动。你的个人运动记录会保留。"
          }
        }
      }
    },
    "Arrived": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrived"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He llegado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已到达"
          }
        }
      }
    },
    "Check in": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check in"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar llegada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签到"
          }
        }
      }
    },
    "Undo check-in": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo check-in"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer confirmación"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销签到"
          }
        }
      }
    },
    "%lld of %lld arrived": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of %lld arrived"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Han llegado %lld de %lld"
