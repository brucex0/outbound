    },
    "Your AI running companion brings your training together with family, friends, and clubs.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compañero de carrera con IA reúne tu entrenamiento con familiares, amigos y clubes."
          }
