    "Date and time" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Fecha y hora" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "日期和时间" } } } },
    "How long did the workout take?" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Cuánto duró el entrenamiento?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这次锻炼用了多长时间？" } } } },
    "I have the workout details. Review them before I save anything." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Ya tengo los detalles. Revísalos antes de guardar el entrenamiento." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "我已整理好锻炼详情。保存前请先确认。" } } } },
