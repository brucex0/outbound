    "plan_builder.conversation.goal_hint": {"comment":"[platform:ios]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a quick reply or describe the goal in your own words."}},"es":{"stringUnit":{"state":"translated","value":"Elige una respuesta rápida o describe el objetivo con tus propias palabras."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择快捷回答，或用自己的话描述目标。"}}}},
    "plan_builder.conversation.optional_answer": {"comment":"[platform:ios]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Optional — you can continue without adding anything."}},"es":{"stringUnit":{"state":"translated","value":"Opcional: puedes continuar sin añadir nada."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选填，你可以不填写并直接继续。"}}}},
    "plan_builder.conversation.success_placeholder": {"comment":"[platform:ios]","localizations":{"en":{"stringUnit":{"state":"translated","value":"For example: longer runs feel comfortable"}},"es":{"stringUnit":{"state":"translated","value":"Por ejemplo: sentirme cómodo en carreras más largas"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"例如：长距离跑起来更轻松"}}}},
