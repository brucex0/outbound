        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改后的内容会成为已确认的信息，并优先于之前的推测。"
          }
        }
      }
    },
    "Your first runs will tune effort, endurance, and recovery. These are starting estimates, not judgments.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus primeras carreras ayudarán a ajustar la intensidad, la resistencia y la recuperación. Son estimaciones iniciales, no juicios."
          }
