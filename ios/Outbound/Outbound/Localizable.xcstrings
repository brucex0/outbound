    "record.goal.calories.weight_prompt.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your weight is needed to estimate calories. It stays private and can be changed in your profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitamos tu peso para estimar las calorías. Se mantiene privado y puedes cambiarlo en tu perfil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你的体重来估算热量。该信息将保持私密，你也可以随时在个人资料中修改。"
          }
        }
      }
    },
