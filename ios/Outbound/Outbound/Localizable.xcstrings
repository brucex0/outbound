    "guide.contract.quiet.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stats, workout transitions, route guidance, and safety only." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Solo estadísticas, cambios de segmento, indicaciones de ruta y avisos de seguridad." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅播报数据、训练阶段切换、路线指引和安全提醒。" } } } },
    "guide.contract.responsive" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Responsive" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Adaptativo" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "适时" } } } },
    "guide.contract.responsive.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Adds coaching when a meaningful change is detected." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Añade indicaciones cuando detecta un cambio importante." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检测到明显变化时提供指导。" } } } },
