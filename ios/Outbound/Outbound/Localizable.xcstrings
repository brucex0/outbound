      }
    },
    "This permanently deletes your Plainstride account, synced activities, plans, profile, social data, and locally stored Plainstride data. This cannot be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente su cuenta de Plainstride, actividades sincronizadas, planes, perfil, datos sociales y datos de Plainstride almacenados localmente. Esto no se puede deshacer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除你的平步青云账户、已同步活动、计划、个人资料、社交数据和本地保存的平步青云数据。此操作无法撤销。"
