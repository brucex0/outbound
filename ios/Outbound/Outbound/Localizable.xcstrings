    "cheer.runner.dismiss": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Dismiss cheer" } }, "es": { "stringUnit": { "state": "translated", "value": "Cerrar el ánimo" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "关闭加油消息" } } } },
    "cheer.runner.heard_from": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ cheered you on" } }, "es": { "stringUnit": { "state": "translated", "value": "%@ te animó" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "%@ 为你加油了" } } } },
    "cheer.runner.moving": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ is moving" } }, "es": { "stringUnit": { "state": "translated", "value": "%@ está en marcha" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "%@ 正在运动" } } } },
