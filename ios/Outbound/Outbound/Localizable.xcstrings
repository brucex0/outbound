    "weather.guidance.cold": {
      "comment": "Shared with Android weather; generated Android name: weather_guidance_cold. [android:weather] Generated Android name: weather_guidance_cold.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm up indoors, cover exposed skin, and keep the first minutes especially easy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calienta bajo techo, cubre la piel expuesta y empieza con especial suavidad."
