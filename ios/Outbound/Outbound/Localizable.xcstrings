    "health.connect.title": {
      "comment": "Shared with Android health; generated Android name: health_connect_title. [android:health] Generated Android name: health_connect_title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your health data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tus datos de salud"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接健康数据"
          }
        }
      }
    },
    "health.connect.body": {
      "comment": "Shared with Android health; generated Android name: health_connect_body. [android:health] Generated Android name: health_connect_body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring recent runs, walks, rides, distance, calories, routes, and heart rate into Plainstride. Completed Plainstride activities can also be shared with Health Connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa en Plainstride tus carreras, caminatas y salidas en bici recientes, con distancia, calorías, rutas y frecuencia cardíaca. También puedes compartir con Health Connect las actividades completadas en Plainstride."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将近期跑步、步行和骑行的距离、热量、路线及心率导入 Plainstride。你也可以把在 Plainstride 完成的活动共享到健康数据共享。"
          }
        }
      }
    },
    "health.connect.privacy": {
      "comment": "Shared with Android health; generated Android name: health_connect_privacy. [android:health] Generated Android name: health_connect_privacy.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You choose each permission. Plainstride only reads or writes the data types you allow, and you can revoke access at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú eliges cada permiso. Plainstride solo lee o escribe los tipos de datos que autorizas y puedes retirar el acceso cuando quieras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每项权限都由你决定。Plainstride 只会读写你允许的数据类型，你也可以随时撤销授权。"
          }
        }
      }
    },
    "health.connect.connected": {
      "comment": "Shared with Android health; generated Android name: health_connect_connected. [android:health] Generated Android name: health_connect_connected.",
