    "A short easy run keeps the rhythm without forcing the full workout." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次短距离轻松跑能保持节奏，不必勉强完成整套训练。"
