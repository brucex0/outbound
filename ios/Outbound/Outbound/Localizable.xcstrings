    "guide.feedback.too_much" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Too much" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Demasiado" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "太多了" } } } },
    "guide.preview.en.balanced" : {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Nice work. Stay relaxed, keep your steps light, and hold this steady rhythm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buen trabajo. Mantén la relajación, pisa ligero y conserva este ritmo estable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做得很好。保持放松，步伐轻盈，稳住这个节奏。"
          }
        }
      }
    },
    "guide.preview.en.calm" : {
      "comment": "Voice preview text for the \"calm\" intensity level in English.",
      "extractionState": "extracted_with_value",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You’re doing well. Relax your shoulders, breathe easily, and let the rhythm come to you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas bien. Relaja los hombros, respira con facilidad y deja que el ritmo llegue solo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你做得不错。放松肩膀，轻松呼吸，让身体自然进入节奏。"
          }
        }
      }
    },
    "guide.preview.en.driven" : {
      "comment": "Preview text for the \"driven\" intensity level in English.",
      "extractionState": "extracted_with_value",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You’ve got this. Stay tall, quicken your feet, and drive through this next stretch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes hacerlo. Mantente erguido, agiliza los pies y aprieta en este siguiente tramo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以的。保持身体挺拔，加快脚步，在接下来这一段继续发力。"
          }
        }
      }
    },
