    "livecoach.privacy": {
      "comment": "Shared with Android livecoach; generated Android name: live_coach_privacy. [android:livecoach] Generated Android name: live_coach_privacy.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live coach sends a bounded activity snapshot for each cue. Exact location, heart-rate data, and spoken audio are not included in analytics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entrenador envía un resumen limitado de la actividad para cada indicación. Las analíticas no incluyen la ubicación exacta, el pulso ni el audio hablado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次生成提示时，实时教练只发送有限的运动摘要。分析数据不包含精确位置、心率或语音内容。"
          }
        }
