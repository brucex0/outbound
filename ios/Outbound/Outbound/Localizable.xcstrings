    "Tap Record to start your first activity." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca «Grabar» para empezar tu primera actividad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点“记录”，开始你的第一次活动。"
          }
        }
      }
    },
    "Tell us the real story. Your companion will turn it into a first session and a plan that fits." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntanos tu situación real. Tu compañero la convertirá en una primera sesión y un plan a tu medida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉我们你的真实情况。你的伙伴会据此制定适合你的首次训练和计划。"
          }
        }
      }
    },
    "Tell us where you are starting." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntanos cuál es tu punto de partida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉我们你目前的跑步状态。"
          }
        }
      }
    },
    "Tell your companion the real story. We will turn it into a first session and a plan that fits." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntale a tu compañero tu situación real. La convertiremos en una primera sesión y un plan que encaje."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉跑步伙伴你的真实情况。我们会据此制定适合你的第一次训练和训练计划。"
          }
        }
      }
    },
    "That photo could not be used." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo usar esa foto."
