    "record.goal.calories.activity_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calorie targets are available for manual runs and walks, plus easy or recovery planned runs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los objetivos de calorías están disponibles para carreras y caminatas manuales, además de carreras planificadas suaves o de recuperación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热量目标适用于手动跑步和步行，以及计划中的轻松跑或恢复跑。"
          }
