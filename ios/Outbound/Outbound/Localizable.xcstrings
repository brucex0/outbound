        }
      }
    },
    "weather.headline.heat": {
      "comment": "Shared with Android weather; generated Android name: weather_headline_heat. [android:weather] Generated Android name: weather_headline_heat.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heat will raise the effort"
