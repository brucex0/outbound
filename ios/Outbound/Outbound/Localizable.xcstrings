    "circle.create.start": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create your Circle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tu círculo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建你的活力圈"
          }
        }
      }
    },
    "circle.created.benefit_activity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking, running, riding, hiking, and swimming all count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminar, correr, montar en bici, hacer senderismo y nadar: todo cuenta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步行、跑步、骑行、徒步和游泳都算数。"
          }
        }
      }
    },
    "circle.created.benefit_cheer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice the effort and send a Cheer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconoce el esfuerzo y envía un mensaje de ánimo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看见彼此的努力，送上鼓励。"
          }
        }
      }
    },
    "circle.created.benefit_details": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the workout behind the progress and celebrate it together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre el entrenamiento detrás del progreso y celébralo en compañía."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看见每一点进步背后的运动，一起庆祝。"
          }
        }
      }
    },
    "circle.created.choose_focus": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a weekly theme"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un tema semanal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择本周主题"
          }
        }
      }
    },
    "circle.created.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your invitations are on the way. When someone joins, activities can begin building shared momentum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las invitaciones están en camino. Cuando alguien se una, las actividades empezarán a crear un impulso compartido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请已发出。有人加入后，每次运动都会为大家积累共同的动力。"
          }
        }
      }
    },
    "circle.created.focus_optional": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The theme is shared. Personal commitments are optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tema es compartido. Los compromisos personales son opcionales."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题属于大家，个人运动承诺完全自愿。"
          }
        }
      }
    },
    "circle.created.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Circle"
          }
