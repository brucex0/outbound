    "Update frequency controls how often your companion offers spoken nudges and live pace, time, and distance recaps during an activity.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La frecuencia determina cada cuánto tu compañero ofrece indicaciones por voz y resúmenes en directo de ritmo, tiempo y distancia durante una actividad."
          }
        },
