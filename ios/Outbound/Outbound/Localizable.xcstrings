    "circle.create.closeness": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made for the family and friends who know you best."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho para la familia y los amigos que mejor te conocen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为最了解你的家人和朋友而设。"
          }
        }
      }
    },
    "circle.create.inspiration_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share goals and progress with the people closest to you—and cheer each other on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte metas y avances con quienes más quieres. Anímense mutuamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和最亲近的人分享目标与进步，彼此加油。"
          }
        }
      }
    },
    "circle.create.inspiration_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active. Positive. Together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activos. Positivos. Juntos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "积极运动，一起向上。"
          }
        }
      }
    },
    "circle.create.people_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose at least one friend or family member. You can invite more later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige al menos a un amigo o familiar. Podrás invitar a más personas después."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少选择一位朋友或家人，之后还可以继续邀请。"
          }
        }
      }
    },
    "circle.create.selected": {
      "localizations": {
