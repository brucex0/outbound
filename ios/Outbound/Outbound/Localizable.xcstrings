      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 90–250 cm for height and 25–350 kg for weight, or leave them blank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa 90–250 cm para la altura y 25–350 kg para el peso, o deja los campos en blanco."
