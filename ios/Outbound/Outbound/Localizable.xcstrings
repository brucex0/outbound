    "A family member has a compatible easy run.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un miembro de la familia tiene una carrera fácil compatible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家庭成员有兼容的轻松跑步。"
          }
        }
      }
    },
    "A starting estimate is enough. Your runs will make it more accurate.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una estimación inicial es suficiente. Tus carreras lo harán más preciso."
