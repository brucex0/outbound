    "activity.goal.coach.distance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You picked the distance. Settle in, then let the rhythm do its work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegiste la distancia. Encuentra tu ritmo y deja que te lleve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选好了距离。先稳下来，然后跟着节奏前进。"
          }
        }
      }
    },
    "activity.goal.coach.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You picked the window. Keep it simple and stay present."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegiste el tiempo. Hazlo sencillo y concéntrate en el momento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选好了时间。保持简单，专注当下。"
          }
        }
      }
    },
    "activity.goal.coach.freestyle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pressure. Just start where you are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin presión. Empieza desde donde estás."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别有压力，就从此刻开始。"
          }
        }
      }
    },
    "activity.goal.freestyle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freestyle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libre"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自由训练"
          }
        }
      }
    },
