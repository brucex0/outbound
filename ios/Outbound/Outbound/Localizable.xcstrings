    "Your correction becomes a confirmed fact and takes precedence over prior inferences.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu corrección se convierte en un dato confirmado y tiene prioridad sobre las conclusiones anteriores."
