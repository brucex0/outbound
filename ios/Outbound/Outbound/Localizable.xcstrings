        }
      }
    },
    "A short reset is enough." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un respiro breve es suficiente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动一动，换换心情。"
          }
        }
      }
    },
    "A short, comfortable start is enough to learn from." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un comienzo corto y cómodo ya nos dará algo que aprender."
