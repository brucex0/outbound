    "plan_builder.conversation.choose_date": {"comment":"[platform:ios]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose event date"}},"es":{"stringUnit":{"state":"translated","value":"Elegir la fecha del evento"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择赛事日期"}}}},
