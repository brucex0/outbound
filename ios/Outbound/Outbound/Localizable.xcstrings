        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短短跑一程、跑得舒服，就能有所收获。"
          }
        }
      }
    },
    "A small session still moves the day forward." : {
      "localizations" : {
