    "Skip the payback workout. Make today easy to repeat." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No entrenes para compensar. Haz algo que mañana quieras repetir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别急着把落下的补回来。轻松一点，才更容易坚持。"
          }
        }
      }
    },
    "Skip track" : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siguiente canción"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下一首"
          }
        }
      }
    },
    "Skipping one run is better than turning discomfort into an injury." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "少跑一次，也比因不适勉强训练而受伤要好。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mejor saltarse una carrera que convertir una molestia en una lesión."
          }
        }
      }
    },
    "Small and repeatable beats ambitious and skipped." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo pequeño que repites vale más que algo ambicioso que nunca ocurre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能反复做到的小事，胜过没有开始的大目标。"
          }
        }
      }
    },
    "SMS and push delivery are stubbed on the server for now. Plainstride will still open the system Share Sheet when a live run starts." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El envío por SMS y notificaciones push aún no está disponible. Plainstride abrirá el menú Compartir del sistema cuando empiece una carrera en directo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
