    "weather.guidance.heat": {
      "comment": "Shared with Android weather; generated Android name: weather_guidance_heat. [android:weather] Generated Android name: weather_guidance_heat.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run by effort instead of pace, carry fluids, and consider a shorter or cooler window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guíate por el esfuerzo, no por el ritmo; lleva líquidos y considera un horario más fresco o una sesión más corta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按体感强度而不是配速跑，带好饮水，并考虑缩短训练或改到更凉爽的时段。"
          }
        }
      }
    },
    "weather.headline.cold": {
      "comment": "Shared with Android weather; generated Android name: weather_headline_cold. [android:weather] Generated Android name: weather_headline_cold.",
