    "race.planner.no_history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There isn’t enough comparable training history for a responsible time target. Race by effort and focus on finishing well."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente historial comparable para recomendar un tiempo responsable. Compite por sensaciones y céntrate en terminar bien."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可比较的训练记录不足，暂时无法负责任地推荐完赛时间。请按体感比赛，专注稳健完赛。"
          }
        }
      }
    },
