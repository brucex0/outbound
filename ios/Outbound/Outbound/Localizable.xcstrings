    "profile.run_goals.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calories apply only to eligible easy and recovery runs. Weight and a reliable learned pace are required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las calorías solo se aplican a carreras suaves y de recuperación compatibles. Se requiere el peso y un ritmo aprendido fiable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热量目标仅适用于符合条件的轻松跑和恢复跑，并且需要体重和可靠的历史配速。"
          }
        }
      }
    },
    "profile.health_details.privacy": {
      "comment": "Privacy explanation for the optional sex-assigned-at-birth field.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sex assigned at birth is optional. Plainstride uses it only to show relevant private health features and never shares it in Together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sexo asignado al nacer es opcional. Plainstride solo lo usa para mostrar funciones de salud privadas relevantes y nunca lo comparte en Juntos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出生时指定的性别为选填项。Plainstride 仅用它来显示相关的私密健康功能，绝不会分享到“一起跑”。"
          }
        }
      }
    },
