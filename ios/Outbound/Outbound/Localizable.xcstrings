    "community.routes.location.body": {
      "comment": "Shared with Android community; generated Android name: routes_location_body. [android:community] Generated Android name: routes_location_body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow approximate location to search a broad nearby area. Plainstride rounds coordinates before requesting routes and does not publish your location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite la ubicación aproximada para buscar en una zona amplia. Plainstride redondea las coordenadas y no publica tu ubicación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许使用大致位置以搜索附近区域。Plainstride 会先对坐标取整，且不会公开你的位置。"
          }
        }
      }
    },
