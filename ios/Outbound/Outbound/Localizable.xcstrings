          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此功能可选并保护隐私。平步青云只会将这些记录保存在本设备上；请求调整时，仅发送通用训练信号。"
          }
        }
      }
