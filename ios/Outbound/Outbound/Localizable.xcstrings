    "guide.voice.language_changed.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The app language changed, so your previous voice may pronounce coaching incorrectly. Spoken guidance is paused until you choose and preview a compatible voice." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El idioma de la app ha cambiado, por lo que la voz anterior podría pronunciar mal las indicaciones. Las indicaciones habladas están pausadas hasta que elijas y pruebes una voz compatible." } },
