    "race.planner.guide": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start patiently, execute your plan, and build only when the effort remains controlled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con paciencia, sigue el plan y aumenta solo si mantienes el esfuerzo bajo control."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "耐心起跑，执行计划，只有在强度仍可控时再逐步发力。"
          }
        }
      }
    },
