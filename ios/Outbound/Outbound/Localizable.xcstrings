    "recording.location.permission.body": {
      "comment": "Shared with Android recording; generated Android name: recording_location_permission_body. [android:recording] Generated Android name: recording_location_permission_body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plainstride uses your location to record distance, pace, and your route. Your route stays private unless you explicitly share it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plainstride usa tu ubicación para registrar la distancia, el ritmo y la ruta. La ruta es privada salvo que decidas compartirla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Plainstride 使用位置信息记录距离、配速和路线。除非你主动分享，否则路线始终保持私密。"
          }
        }
      }
    },
