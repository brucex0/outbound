    "live_guidance.auto_pause": {
      "comment": "Spoken when movement-based auto-pause stops an active workout.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workout paused."
          }
        },
        "es": {
          "stringUnit": {
