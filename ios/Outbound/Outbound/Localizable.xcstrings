            "state": "translated",
            "value": "Safety & live sharing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguridad y ubicación en vivo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全与实时位置"
          }
        }
      }
    },
    "safety.safety.explanation": {
      "comment": "Shared with Android safety; generated Android name: safety_explanation. [android:safety] Generated Android name: safety_explanation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share a time-limited private link with people you trust. Live sharing is off by default and ends when you stop or finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte un enlace privado y temporal con personas de confianza. Está desactivado por defecto y termina cuando paras o finalizas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向信任的人分享有时限的私密链接。实时位置默认关闭，并会在你停止或结束活动时终止。"
          }
        }
      }
    },
    "safety.safety.notification.title": {
      "comment": "Shared with Android safety; generated Android name: safety_notification_title. [android:safety] Generated Android name: safety_notification_title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay informed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantente al tanto"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "及时了解动态"
          }
        }
      }
    },
    "safety.safety.notification.body": {
      "comment": "Shared with Android safety; generated Android name: safety_notification_body. [android:safety] Generated Android name: safety_notification_body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications for invitations, Cheers, and important Circle updates. Your inbox still works if you decline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite notificaciones de invitaciones, ánimos y novedades importantes del Círculo. La bandeja seguirá disponible si no aceptas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许接收邀请、鼓励和重要圈子动态。即使拒绝权限，站内通知仍然可用。"
          }
        }
      }
    },
