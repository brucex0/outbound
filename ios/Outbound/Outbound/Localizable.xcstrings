    "tooltip.cheer_me_on": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite loved ones to follow along and cheer you on"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a tus seres queridos a seguirte y animarte"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请亲友关注你的活动并为你加油"
