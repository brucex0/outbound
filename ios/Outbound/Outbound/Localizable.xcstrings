    "progress.insight.volume.up.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your rolling 28-day distance is %d%% higher than the previous 28 days."}},"es":{"stringUnit":{"state":"translated","value":"Tu distancia de los últimos 28 días es un %d%% mayor que en los 28 anteriores."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最近 28 天的里程比此前 28 天高 %d%%。"}}}},
    "progress.insight.volume.down.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your rolling 28-day distance is %d%% lower than the previous 28 days."}},"es":{"stringUnit":{"state":"translated","value":"Tu distancia de los últimos 28 días es un %d%% menor que en los 28 anteriores."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最近 28 天的里程比此前 28 天低 %d%%。"}}}},
    "progress.insight.consistency.body.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You recorded activity in %d of the last %d weeks."}},"es":{"stringUnit":{"state":"translated","value":"Registraste actividad en %d de las últimas %d semanas."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"过去 %2$d 周中，你有 %1$d 周记录了活动。"}}}},
    "progress.insight.endurance.body.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your longest activity accounts for %d%% of this week's distance."}},"es":{"stringUnit":{"state":"translated","value":"Tu actividad más larga representa el %d%% de la distancia semanal."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最长一次活动占本周总里程的 %d%%。"}}}},
    "progress.insight.efficiency.up.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recent runs were %d%% faster at a similar average heart rate (%+d bpm)."}},"es":{"stringUnit":{"state":"translated","value":"Tus carreras recientes fueron un %d%% más rápidas con una frecuencia cardiaca media similar (%+d ppm)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在平均心率相近（%2$+d 次/分）时，近期跑步配速快了 %1$d%%。"}}}},
    "progress.insight.efficiency.down.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recent runs were %d%% slower at a similar average heart rate (%+d bpm)."}},"es":{"stringUnit":{"state":"translated","value":"Tus carreras recientes fueron un %d%% más lentas con una frecuencia cardiaca media similar (%+d ppm)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在平均心率相近（%2$+d 次/分）时，近期跑步配速慢了 %1$d%%。"}}}},
    "progress.insight.load.up.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Heart-rate-weighted load rose %d%% over the previous seven days."}},"es":{"stringUnit":{"state":"translated","value":"La carga ponderada por frecuencia cardiaca subió un %d%% frente a los siete días anteriores."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"心率加权负荷较此前 7 天上升了 %d%%。"}}}},
    "progress.insight.load.down.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Heart-rate-weighted load fell %d%% from the previous seven days."}},"es":{"stringUnit":{"state":"translated","value":"La carga ponderada por frecuencia cardiaca bajó un %d%% frente a los siete días anteriores."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"心率加权负荷较此前 7 天下降了 %d%%。"}}}},
    "progress.insight.balance.body.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%d%% of recent heart-rate time was in zones 4–5."}},"es":{"stringUnit":{"state":"translated","value":"El %d%% del tiempo reciente con frecuencia cardiaca estuvo en las zonas 4–5."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"近期心率记录中有 %d%% 处于第 4–5 区。"}}}},
    "progress.insight.goals.body.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You completed %d of %d measurable activity goals in the last 28 days."}},"es":{"stringUnit":{"state":"translated","value":"Completaste %d de %d objetivos medibles en los últimos 28 días."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最近 28 天内，%2$d 个可衡量活动目标中完成了 %1$d 个。"}}}},
    "progress.insight.pattern.body.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%d%% of your recent activities started in the %@."}},"es":{"stringUnit":{"state":"translated","value":"El %d%% de tus actividades recientes comenzaron por la %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"近期活动中有 %d%% 在%@开始。"}}}},
    "progress.day_part.morning": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"morning"}},"es":{"stringUnit":{"state":"translated","value":"mañana"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"早晨"}}}},
    "progress.day_part.afternoon": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"afternoon"}},"es":{"stringUnit":{"state":"translated","value":"tarde"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下午"}}}},
    "progress.day_part.evening": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"evening"}},"es":{"stringUnit":{"state":"translated","value":"tarde-noche"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"晚间"}}}},
    "progress.evidence.distance.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ now · %@ before"}},"es":{"stringUnit":{"state":"translated","value":"%@ ahora · %@ antes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目前 %@ · 此前 %@"}}}},
    "progress.evidence.weeks.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%d active weeks · %d-week window"}},"es":{"stringUnit":{"state":"translated","value":"%d semanas activas · periodo de %d semanas"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%1$d 个活跃周 · %2$d 周周期"}}}},
    "progress.evidence.long_run.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ longest · %@ this week"}},"es":{"stringUnit":{"state":"translated","value":"%@ la más larga · %@ esta semana"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最长 %@ · 本周 %@"}}}},
    "progress.evidence.efficiency.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%+d%% pace · %+d bpm"}},"es":{"stringUnit":{"state":"translated","value":"%+d%% ritmo · %+d ppm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配速 %+d%% · 心率 %+d 次/分"}}}},
    "progress.evidence.load.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%.0f load now · %.0f before"}},"es":{"stringUnit":{"state":"translated","value":"%.0f de carga ahora · %.0f antes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目前负荷 %.0f · 此前 %.0f"}}}},
    "progress.evidence.intensity.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%d%% high intensity"}},"es":{"stringUnit":{"state":"translated","value":"%d%% de alta intensidad"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"高强度占 %d%%"}}}},
    "progress.evidence.goals.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%d completed · %d measured"}},"es":{"stringUnit":{"state":"translated","value":"%d completados · %d medidos"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"完成 %d 个 · 衡量 %d 个"}}}},
    "progress.evidence.pattern.format": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%d%% %@ · %d activities"}},"es":{"stringUnit":{"state":"translated","value":"%d%% por la %@ · %d actividades"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%d%% 在%@ · %d 次活动"}}}},
    "progress.action.volume_high": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Leave room for recovery before adding more volume."}},"es":{"stringUnit":{"state":"translated","value":"Deja espacio para recuperarte antes de aumentar el volumen."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"继续增加训练量前，先留出恢复空间。"}}}},
    "progress.action.volume": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep the next change gradual and let consistency lead."}},"es":{"stringUnit":{"state":"translated","value":"Haz el próximo cambio de forma gradual y prioriza la constancia."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下次调整保持循序渐进，以持续性为先。"}}}},
    "progress.action.consistency": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Protect the routine with a short, doable next session."}},"es":{"stringUnit":{"state":"translated","value":"Protege la rutina con una próxima sesión corta y factible."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下一次安排短而可行的训练，守住这个节奏。"}}}},
    "progress.action.endurance_high": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep the next session easy; one activity carried most of the week."}},"es":{"stringUnit":{"state":"translated","value":"Haz suave la próxima sesión; una sola actividad concentró casi toda la semana."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下一次轻松一些；本周大部分里程集中在一次活动中。"}}}},
    "progress.action.endurance": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Build endurance gradually while keeping the rest of the week comfortable."}},"es":{"stringUnit":{"state":"translated","value":"Desarrolla resistencia poco a poco y mantén cómodo el resto de la semana."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"逐步提升耐力，同时让一周其余训练保持轻松。"}}}},
    "progress.action.efficiency_up": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep effort controlled—the faster pace does not need to become a new minimum."}},"es":{"stringUnit":{"state":"translated","value":"Mantén el esfuerzo controlado; ese ritmo más rápido no tiene que convertirse en el nuevo mínimo."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"继续控制强度；配速变快不代表以后每次都必须达到。"}}}},
    "progress.action.efficiency_down": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Treat this as context, not a verdict; terrain, fatigue, and weather can all matter."}},"es":{"stringUnit":{"state":"translated","value":"Tómalo como contexto, no como sentencia: el terreno, la fatiga y el clima también influyen."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"把它当作背景信息，而非结论；地形、疲劳和天气都会产生影响。"}}}},
    "progress.action.load_high": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Consider an easier day before the next demanding session."}},"es":{"stringUnit":{"state":"translated","value":"Valora un día más suave antes de la próxima sesión exigente."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下一次高强度训练前，可以考虑安排轻松一天。"}}}},
    "progress.action.load": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Watch how you feel and keep load changes gradual."}},"es":{"stringUnit":{"state":"translated","value":"Observa cómo te sientes y cambia la carga de forma gradual."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"留意身体感受，让负荷变化保持平缓。"}}}},
    "progress.action.intensity_high": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A larger easy share can help absorb the harder work."}},"es":{"stringUnit":{"state":"translated","value":"Una mayor proporción de trabajo suave puede ayudarte a asimilar las sesiones duras."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"增加轻松训练的占比，有助于消化高强度训练。"}}}},
    "progress.action.intensity": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep easy work genuinely easy and add intensity with purpose."}},"es":{"stringUnit":{"state":"translated","value":"Haz que lo suave sea realmente suave y añade intensidad con intención."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"轻松训练要真正轻松，高强度训练则要目的明确。"}}}},
    "progress.action.goals": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Set targets that support the week instead of forcing every activity."}},"es":{"stringUnit":{"state":"translated","value":"Elige objetivos que apoyen tu semana sin forzar cada actividad."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"让目标服务于整周安排，而不是勉强每一次活动。"}}}},
