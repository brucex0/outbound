    "Add shoes in Settings to track mileage by pair.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue zapatillas en Configuración para realizar un seguimiento del kilometraje por par."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中添加鞋子以跟踪每双的里程数。"
          }
        }
      }
    },
    "Add someone you trust. Plainstride will use them as the default recipient when you turn on Share live run.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega a alguien en quien confíes. Plainstride los usará como destinatario predeterminado cuando active Compartir carrera en vivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加您信任的人。当您打开共享实时跑步时，平步青云会将它们用作默认收件人。"
          }
        }
      }
    },
    "Add trusted contact": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregar contacto de confianza"
          }
        },
        "zh-Hans": {
