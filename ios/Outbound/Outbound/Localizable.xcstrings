    "plan_builder.event.date": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Event date"}},"es":{"stringUnit":{"state":"translated","value":"Fecha del evento"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"赛事日期"}}}},
