        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indícame una distancia, duración, objetivo de calorías o esfuerzo —por ejemplo, «15 km», «45 minutos», «300 calorías» o «hazla suave»— y actualizaré la actividad."
