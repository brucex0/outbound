    "watch.disconnected.toast": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Apple Watch disconnected — phone recording continues." } }, "es": { "stringUnit": { "state": "translated", "value": "El Apple Watch se desconectó; el iPhone sigue registrando." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Apple Watch 已断开，iPhone 会继续记录。" } } } },
    "watch.connected.toast": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Heart rate connected." } }, "es": { "stringUnit": { "state": "translated", "value": "Frecuencia cardíaca conectada." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "心率已连接。" } } } },
    "watch.connecting.toast": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Connecting to Apple Watch…" } }, "es": { "stringUnit": { "state": "translated", "value": "Conectando con el Apple Watch…" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在连接 Apple Watch…" } } } },
    "watch.error.continuing": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Apple Watch connection changed — your workout is still recording." } }, "es": { "stringUnit": { "state": "translated", "value": "Cambió la conexión con el Apple Watch; tu entrenamiento se sigue registrando." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Apple Watch 连接状态有变化，你的训练仍在继续记录。" } } } },
    "watch.hr.unavailable": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No signal" } }, "es": { "stringUnit": { "state": "translated", "value": "Sin señal" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无信号" } } } },
    "watch.hr.waiting": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Waiting" } }, "es": { "stringUnit": { "state": "translated", "value": "Esperando" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "等待中" } } } },
    "watch.hr.zone.format": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Zone %d" } }, "es": { "stringUnit": { "state": "translated", "value": "Zona %d" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "第 %d 区" } } } },
    "watch.phone.active_detail": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Recording from Apple Watch" } }, "es": { "stringUnit": { "state": "translated", "value": "Registrando desde el Apple Watch" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "由 Apple Watch 记录" } } } },
    "watch.phone.active_guide": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Your watch is measuring the workout while Plainstride handles the live experience." } }, "es": { "stringUnit": { "state": "translated", "value": "Tu reloj mide el entrenamiento mientras Plainstride gestiona la experiencia en vivo." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "手表负责测量训练数据，Plainstride 负责实时体验。" } } } },
    "watch.phone.active_title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Apple Watch workout" } }, "es": { "stringUnit": { "state": "translated", "value": "Entrenamiento del Apple Watch" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Apple Watch 训练" } } } },
    "watch.phone_only.toast": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Apple Watch unavailable — continuing without live heart rate." } }, "es": { "stringUnit": { "state": "translated", "value": "Apple Watch no disponible; continuamos sin frecuencia cardíaca en vivo." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Apple Watch 不可用，将在没有实时心率的情况下继续。" } } } },
