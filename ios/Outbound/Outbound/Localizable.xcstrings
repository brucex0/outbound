    "guide.voice.required.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose and preview a compatible voice before spoken guidance begins. Standard voices require an additional quality warning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige y prueba una voz compatible antes de iniciar las indicaciones habladas. Las voces estándar requieren una advertencia adicional sobre su calidad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先选择并试听兼容的语音，再开始语音指导。选择标准语音时还会显示额外的质量警告。"
          }
