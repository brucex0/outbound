    "guide.feedback.helpful" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Helpful" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Útil" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "有帮助" } } } },
    "guide.feedback.privacy" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Feedback improves cue timing and frequency. Coaching text is not included in analytics." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Los comentarios mejoran el momento y la frecuencia de las indicaciones. El texto de las indicaciones no se incluye en los análisis." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "反馈会改善提示时机和频率。分析数据不包含指导文本。" } } } },
    "guide.feedback.section.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "How was live guidance?" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Qué tal fueron las indicaciones en directo?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "实时指导体验如何？" } } } },
    "guide.feedback.summary.format" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$d cues · %2$d helped" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "%1$d indicaciones · %2$d útiles" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%1$d 条指导 · %2$d 条有帮助" } } } },
