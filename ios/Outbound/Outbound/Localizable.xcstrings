    "race.planner.based_on_history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on %d relevant recent runs, start patiently and aim for %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según %d carreras recientes relevantes, empieza con paciencia e intenta lograr %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据近期 %d 次相关跑步，建议耐心起跑，目标 %@。"
