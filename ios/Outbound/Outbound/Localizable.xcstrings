    "profile.about_you.footer": {
      "comment": "Explains which fields in the unified About You section may be shared and which remain private.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name, username, and bio may appear in Together. Your other details stay private. You can change your username once every 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre, nombre de usuario y biografía pueden aparecer en Juntos. Tus demás datos permanecen privados. Puedes cambiar tu nombre de usuario una vez cada 30 días."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的姓名、用户名和简介可能会显示在“一起跑”中，其他资料将保持私密。用户名每 30 天可更改一次。"
          }
        }
      }
    },
    "profile.training_details": {
      "comment": "Section heading for private body and training-personalization fields in the consolidated Profile editor.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training details"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de entrenamiento"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练资料"
          }
        }
      }
    },
    "profile.training_details.birthday_footer": {
      "comment": "Explains why the app stores a birth date instead of a changing age value.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Birthday is stored instead of age so your details stay accurate over time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda tu fecha de nacimiento, en lugar de tu edad, para que tus datos sigan siendo correctos con el tiempo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统会保存出生日期而不是年龄，确保资料始终准确。"
          }
        }
      }
    },
