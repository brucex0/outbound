    "Add shoes in Settings to track mileage by pair.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade zapatillas en Ajustes para registrar el kilometraje de cada par."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中添加跑鞋，记录每双鞋的里程。"
          }
        }
      }
    },
    "Add someone you trust. Plainstride will use them as the default recipient when you turn on Share live run.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade a alguien de confianza. Plainstride será quien reciba por defecto tus carreras en directo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一位你信任的人。开启实时跑步分享后，平步青云会自动将链接发送给对方。"
          }
        }
      }
    },
    "Add the first bit of encouragement.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el primer mensaje de ánimo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来送上第一句鼓励吧。"
          }
        }
      }
    },
    "Add today’s private check-in": {
      "localizations": {
        "es": {
