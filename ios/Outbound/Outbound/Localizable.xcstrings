    "cheer.status.heard": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Heard" } }, "es": { "stringUnit": { "state": "translated", "value": "Escuchado" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "已听到" } } } },
