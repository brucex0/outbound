    "recognition.empty.detail": {
      "comment": "Explains how the runner can begin earning milestones without framing them as requirements.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save activities and meaningful firsts, distance, consistency, and comebacks will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda actividades y aquí aparecerán tus primeros logros, distancias, constancia y regresos importantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存活动后，重要的首次突破、距离、坚持与回归都会记录在这里。"
          }
        }
      }
    },
    "recognition.history.intro": {
      "comment": "Explains what qualifies for the durable milestone history.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moments here mark meaningful beginnings, distance, consistency, and comebacks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos hitos marcan comienzos, distancias, constancia y regresos que de verdad importan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里记录真正重要的开始、距离突破、持续坚持与重新出发。"
          }
        }
      }
    },
