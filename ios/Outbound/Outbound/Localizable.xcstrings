    "activity.guide.reflection_body": {
      "comment": "Fallback reflection shown when a completed activity has no generated reflection. [android:activity] Generated Android name: activity_guide_reflection_body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You showed up and added another honest effort to your story. Notice what felt strong and carry that into the next one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te presentaste y sumaste otro esfuerzo sincero a tu historia. Fíjate en lo que se sintió fuerte y llévalo contigo a la próxima."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你如约出发，又为自己的故事写下了一次踏实的努力。记住这次表现出色的地方，把它带到下一次训练中。"
          }
        }
      }
    },
