    "cheer.activity.ended": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "This activity has ended" } }, "es": { "stringUnit": { "state": "translated", "value": "Esta actividad ha terminado" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "本次活动已结束" } } } },
    "cheer.hold_to_record": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Hold to cheer" } }, "es": { "stringUnit": { "state": "translated", "value": "Mantén pulsado para animar" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "按住录制加油" } } } },
    "cheer.navigation.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Cheer %@ on" } }, "es": { "stringUnit": { "state": "translated", "value": "Anima a %@" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "为 %@ 加油" } } } },
    "cheer.release_to_send": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Release to send" } }, "es": { "stringUnit": { "state": "translated", "value": "Suelta para enviar" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "松开发送" } } } },
