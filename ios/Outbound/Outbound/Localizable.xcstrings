          }
        }
      }
    },
    "Add your current pair and Plainstride will attach it to new runs by default.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu par actual y Plainstride lo asociará por defecto a las carreras nuevas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加你现在穿的跑鞋，平步青云会默认将它用于新的跑步记录。"
