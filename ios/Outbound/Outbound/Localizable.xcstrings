    "guide.contract.coach_me.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Offers more frequent coaching around useful moments." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ofrece indicaciones más frecuentes en momentos útiles." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在关键时刻提供更频繁的指导。" } } } },
