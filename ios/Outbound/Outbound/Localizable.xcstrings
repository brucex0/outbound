    "personalization.readiness.sore" : {
      "comment": "Explanation of the impact of soreness on the recommendation.",
      "extractionState": "extracted_with_value",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Soreness can change today's recommendation. Pain should not be treated as a training signal to push through."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las molestias pueden cambiar la recomendación de hoy. El dolor no debe interpretarse como una señal para seguir forzando."
