    "onboarding.profile.required_title": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Private planning details"}},"es":{"stringUnit":{"state":"translated","value":"Datos privados para tu plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"私密计划信息"}}}},
    "onboarding.profile.required_subtitle": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Birth date, sex assigned at birth, and weight are required for safe plan personalization and calorie calculations. You can enter them manually or import available values from Apple Health. Height is optional."}},"es":{"stringUnit":{"state":"translated","value":"La fecha de nacimiento, el sexo asignado al nacer y el peso son necesarios para personalizar el plan con seguridad y calcular las calorías. Puedes introducirlos o importar los datos disponibles de Apple Health. La altura es opcional."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为了安全地制定个性化计划并计算热量，需要填写出生日期、出生时指定的性别和体重。你可以手动输入，也可以从 Apple 健康导入现有数据。身高为可选项。"}}}},
    "onboarding.profile.required_error": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Add a valid birth date, sex assigned at birth, and weight to continue."}},"es":{"stringUnit":{"state":"translated","value":"Añade una fecha de nacimiento válida, el sexo asignado al nacer y el peso para continuar."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请填写有效的出生日期、出生时指定的性别和体重后继续。"}}}},
    "common.optional": {"comment":"[platform:ios]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Optional"}},"es":{"stringUnit":{"state":"translated","value":"Opcional"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可选"}}}},
    "common.retry": {"comment":"[platform:ios]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Retry"}},"es":{"stringUnit":{"state":"translated","value":"Reintentar"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试"}}}},
    "plan_builder.activity.mobility": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Mobility"}},"es":{"stringUnit":{"state":"translated","value":"Movilidad"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"灵活性训练"}}}},
    "plan_builder.activity.strength": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Strength"}},"es":{"stringUnit":{"state":"translated","value":"Fuerza"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"力量训练"}}}},
    "plan_builder.activity.walk_hike": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Walk / Hike"}},"es":{"stringUnit":{"state":"translated","value":"Caminar / Senderismo"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"步行 / 徒步"}}}},
    "plan_builder.activities.subtitle": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose one or more. Plainstride will balance them across your week."}},"es":{"stringUnit":{"state":"translated","value":"Elige una o más. Plainstride las distribuirá de forma equilibrada durante la semana."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择一项或多项运动，Plainstride 会在一周内合理安排。"}}}},
    "plan_builder.activities.supporting": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Supporting activities (optional)"}},"es":{"stringUnit":{"state":"translated","value":"Actividades complementarias (opcional)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"辅助运动（可选）"}}}},
    "plan_builder.activities.title": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Which activities should your plan use?"}},"es":{"stringUnit":{"state":"translated","value":"¿Qué actividades debe incluir tu plan?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的计划应包含哪些运动？"}}}},
    "plan_builder.baseline.active": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Currently active"}},"es":{"stringUnit":{"state":"translated","value":"Entreno actualmente"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目前有规律运动"}}}},
    "plan_builder.baseline.duration": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Comfortable session: %d min"}},"es":{"stringUnit":{"state":"translated","value":"Sesión cómoda: %d min"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"舒适运动时长：%d 分钟"}}}},
    "plan_builder.baseline.frequency": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Recent sessions: %d per week"}},"es":{"stringUnit":{"state":"translated","value":"Sesiones recientes: %d por semana"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"近期运动：每周 %d 次"}}}},
    "plan_builder.baseline.returning": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Returning after a break"}},"es":{"stringUnit":{"state":"translated","value":"Vuelvo después de una pausa"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"休息一段时间后重返"}}}},
    "plan_builder.baseline.starting": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Starting out"}},"es":{"stringUnit":{"state":"translated","value":"Estoy empezando"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刚开始运动"}}}},
    "plan_builder.baseline.subtitle": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"A rough starting point is enough. Your first three relevant sessions will refine it."}},"es":{"stringUnit":{"state":"translated","value":"Una estimación inicial es suficiente. Tus primeras tres sesiones relevantes la afinarán."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"大致的起点就够了。系统会根据你最先完成的三次相关运动逐步校准。"}}}},
    "plan_builder.baseline.title": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Where are you starting from?"}},"es":{"stringUnit":{"state":"translated","value":"¿Cuál es tu punto de partida?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你目前的起点如何？"}}}},
    "plan_builder.baseline.observed": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Based on your last 28 days"}},"es":{"stringUnit":{"state":"translated","value":"Según tus últimos 28 días"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"根据你最近 28 天的记录"}}}},
    "plan_builder.baseline.observed_summary": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"%1$d sessions across %2$d weeks · typically %3$d min · longest %4$d min"}},"es":{"stringUnit":{"state":"translated","value":"%1$d sesiones en %2$d semanas · normalmente %3$d min · máximo %4$d min"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%2$d 周内完成 %1$d 次 · 通常 %3$d 分钟 · 最长 %4$d 分钟"}}}},
    "plan_builder.baseline.update": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Update it"}},"es":{"stringUnit":{"state":"translated","value":"Actualizar"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修改"}}}},
    "plan_builder.baseline.use": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use this baseline"}},"es":{"stringUnit":{"state":"translated","value":"Usar este punto de partida"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用这个起点"}}}},
    "plan_builder.coach_prompt.action": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use this goal"}},"es":{"stringUnit":{"state":"translated","value":"Usar este objetivo"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用这个目标"}}}},
    "plan_builder.coach_prompt.error": {"comment":"[platform:ios]","localizations":{"en":{"stringUnit":{"state":"translated","value":"I couldn’t interpret that reliably. Try again or choose a quick reply."}},"es":{"stringUnit":{"state":"translated","value":"No pude interpretar el objetivo con seguridad. Inténtalo de nuevo o elige una respuesta rápida."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"我无法准确理解这个目标。请重试或选择一个快捷回答。"}}}},
    "plan_builder.coach_prompt.optional_action": {"comment":"[platform:ios]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Describe a specific goal instead"}},"es":{"stringUnit":{"state":"translated","value":"Prefiero describir un objetivo concreto"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"改为描述具体目标"}}}},
    "plan_builder.coach_prompt.placeholder": {"comment":"[platform:ios] [android:onboarding]","localizations":{"en":{"stringUnit":{"state":"translated","value":"For example: Prepare for a half marathon"}},"es":{"stringUnit":{"state":"translated","value":"Por ejemplo: prepararme para una media maratón"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"例如：备战半程马拉松"}}}},
    "plan_builder.coach_prompt.subtitle": {"comment":"[platform:ios]","localizations":{"en":{"stringUnit":{"state":"translated","value":"We’ll match your description to a plan goal. You can review the details before continuing."}},"es":{"stringUnit":{"state":"translated","value":"Relacionaremos tu descripción con un objetivo del plan. Podrás revisar los detalles antes de continuar."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"我们会将你的描述匹配到一个计划目标，你可以在继续前核对详细信息。"}}}},
    "plan_builder.coach_prompt.title": {"comment":"[platform:ios]","localizations":{"en":{"stringUnit":{"state":"translated","value":"Describe your goal"}},"es":{"stringUnit":{"state":"translated","value":"Describe tu objetivo"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"描述你的目标"}}}},
