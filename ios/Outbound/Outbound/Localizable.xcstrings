    "guide.voice.language_changed.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app language changed, so your previous voice may pronounce coaching incorrectly. Spoken guidance is paused until you choose and preview a compatible voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de la app ha cambiado, por lo que la voz anterior podría pronunciar mal las indicaciones. Las indicaciones habladas están pausadas hasta que elijas y pruebes una voz compatible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 语言已更改，之前的语音可能无法正确朗读指导内容。在你选择并试听兼容的语音前，语音指导将暂停。"
          }
        }
      }
    },
