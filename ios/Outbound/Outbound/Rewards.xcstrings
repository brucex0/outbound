    "rewards.free_fallback" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Core plans, fixed voice guidance, and live safety sharing remain available without Plus." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Los planes básicos, la guía de voz fija y las funciones de seguridad en vivo siguen disponibles sin Plus." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无需 Plus 也可继续使用基础计划、固定语音指导和实时安全共享。" } } } },
    "rewards.invitation_placeholder" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Invitation code" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Código de invitación" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "邀请码" } } } },
    "rewards.invitation_code_body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Share your permanent invitation and see who gets moving." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Comparte tu invitación permanente y descubre quién empieza a moverse." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "分享你的专属长期邀请码，看看谁开始行动。" } } } },
