    "rewards.redeem_detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Invitation codes can be claimed during your first seven days. Contribution codes are issued by Plainstride." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Los códigos de invitación se pueden canjear durante tus primeros siete días. Plainstride emite los códigos de contribución." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "邀请码可在注册后的前 7 天内领取；贡献奖励码由平步青云发放。" } } } },
