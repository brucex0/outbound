    "rewards.invite_detail_format" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A new runner receives %lld days of Plus when they claim your invitation. You receive %lld days after their first activity of at least %lld minutes." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El nuevo corredor recibe %lld días de Plus al canjear tu invitación. Tú recibes %lld días cuando complete su primera actividad de al menos %lld minutos." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新跑者领取你的邀请后可获得 %lld 天 Plus；完成首次活动后，你可获得 %lld 天 Plus（活动时长至少 %lld 分钟）。" } } } },
    "rewards.invite_detail_founding_format" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "New runners you invite receive %lld days of Plus. They can claim your invitation during their first %lld days after joining." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Los nuevos corredores que invites reciben %lld días de Plus. Pueden canjear tu invitación durante sus primeros %lld días después de registrarse." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你邀请的新跑者可获得 %lld 天 Plus。他们可在注册后的前 %lld 天内领取邀请。" } } } },
