    "rewards.plus_options_detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a weekly, monthly, or yearly subscription. Prices and terms are shown before purchase." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige una suscripción semanal, mensual o anual. Verás los precios y las condiciones antes de comprar." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可选择周订阅、月订阅或年订阅。购买前会显示价格和条款。" } } } },
