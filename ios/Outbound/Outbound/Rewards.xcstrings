    "rewards.invite_detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You and a new runner each earn 14 days of Plus. Your reward arrives after their first activity of at least 10 minutes." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Tú y el nuevo corredor reciben 14 días de Plus. Tu recompensa llega después de que complete su primera actividad de al menos 10 minutos." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你和新跑者都可获得 14 天 Plus。对方完成首次至少 10 分钟的活动后，你的奖励即可到账。" } } } },
    "rewards.live_coach" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Dynamic live voice guide" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Guía de voz dinámica en vivo" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "动态实时语音指导" } } } },
