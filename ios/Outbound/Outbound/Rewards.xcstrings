    "rewards.share_message_format" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Join me on Plainstride and claim %lld days of Plus. If you install Plainstride first, return to this message and tap the link again afterward." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Únete a Plainstride conmigo y recibe %lld días de Plus. Si primero instalas Plainstride, vuelve a este mensaje y toca de nuevo el enlace después." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "和我一起加入平步青云，领取 %lld 天 Plus。如果需要先安装平步青云，安装后请回到这条消息，再点一次链接。" } } } },
    "rewards.share_message_founding_format" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Join me on Plainstride and claim %lld days of Plus. If you install Plainstride first, return to this message and tap the link again afterward." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Únete a Plainstride conmigo y recibe %lld días de Plus. Si primero instalas Plainstride, vuelve a este mensaje y toca de nuevo el enlace después." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "和我一起加入平步青云，领取 %lld 天 Plus。如果需要先安装平步青云，安装后请回到这条消息，再点一次链接。" } } } },
