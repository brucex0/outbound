    "rewards.current_rewards_detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Plus benefits you earn or receive appear here." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Aquí aparecen las ventajas de Plus que ganes o recibas." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你赚取或获赠的 Plus 权益会显示在这里。" } } } },
