{
  "sourceLanguage": "en",
  "strings": {
    "social.event.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel activity"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar actividad"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消活动"
          }
        }
      }
    },
    "social.event.cancel.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this activity?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar esta actividad?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消此活动？"
          }
        }
      }
    },
    "social.event.cancel.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Participants and invited friends will be notified. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se avisará a los participantes y a los amigos invitados. Esta acción no se puede deshacer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参与者和受邀好友将收到通知。取消后无法恢复。"
          }
        }
      }
    },
    "social.event.keep": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep activity"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener actividad"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留活动"
          }
        }
      }
    },
    "social.event.cancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消"
          }
        }
      }
    },
    "social.event.cancelled.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This activity has been cancelled. You can no longer join or start it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta actividad se ha cancelado. Ya no puedes unirte ni iniciarla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此活动已取消，无法再加入或开始。"
          }
        }
      }
    },
    "social.event.cancel.success": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actividad cancelada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动已取消。"
          }
        }
      }
    },
    "social.event.cancel.failure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not cancel activity. Refresh and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cancelar la actividad. Actualiza e inténtalo de nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法取消活动，请刷新后重试。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
