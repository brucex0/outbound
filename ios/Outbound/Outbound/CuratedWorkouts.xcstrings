      }
    },
    "Focused and purposeful": {
      "comment": "Original curated workout editorial copy. Preserve all numbers and safety meaning.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注、有目标"
          }
        }
      }
    },
    "Stay present as fatigue grows; build gently only if pace and form remain under control.": {
      "comment": "Original curated workout editorial copy. Preserve all numbers and safety meaning.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "疲劳增加时保持专注，只有配速和姿态仍然可控时才轻轻加力。"
          }
        }
      }
    },
    "Three kilometres left. Focus, do not force.": {
      "comment": "Original curated workout editorial copy. Preserve all numbers and safety meaning.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还剩3公里，专注就好，不要硬撑。"
          }
        }
      }
    },
    "Hold steady or use a short walk reset rather than letting form unravel.": {
      "comment": "Original curated workout editorial copy. Preserve all numbers and safety meaning.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
