      }
    },
    "Keep the current effort and run evenly through the line.": {
      "comment": "Original curated workout editorial copy. Preserve all numbers and safety meaning.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持当前强度，均匀跑过终点。"
