        }
      }
    },
    "Use the final kilometre progressively: first hold form, then lift cadence toward the finish.": {
      "comment": "Original curated workout editorial copy. Preserve all numbers and safety meaning.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
