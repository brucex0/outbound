    },
    "Run · 21.1 km · prepared endurance effort": {
      "comment": "Original curated workout editorial copy. Preserve all numbers and safety meaning.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跑步 · 21.1公里 · 需具备耐力基础"
          }
        }
      }
    },
    "Break the distance into calm sections, follow your practiced fueling plan, and protect the first half.": {
      "comment": "Original curated workout editorial copy. Preserve all numbers and safety meaning.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
