          }
        }
      }
    },
    "One kilometre. Build in control and finish proud.": {
      "comment": "Original curated workout editorial copy. Preserve all numbers and safety meaning.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
