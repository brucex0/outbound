        }
      }
    },
    "Warm up gradually and identify safe landmarks for the faster blocks.": {
      "comment": "Original curated workout editorial copy. Preserve all numbers and safety meaning.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐步热身，为快速段留意安全的路标。"
