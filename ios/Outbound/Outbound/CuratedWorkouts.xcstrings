        }
      }
    },
    "Compare the feel of the first two and final two kilometres before judging the result.": {
      "comment": "Original curated workout editorial copy. Preserve all numbers and safety meaning.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
