          "stringUnit": {
            "state": "translated",
            "value": "Extra fuel is usually unnecessary for a short session"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una sesión corta, normalmente no hace falta comer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短时间训练通常不需要额外补充食物"
          }
        }
      }
    },
    "card.during.medium": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan access to a drink; fueling depends on effort and comfort"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten una bebida a mano; comer depende del esfuerzo y de cómo te sientas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备好饮品，是否补充食物取决于强度与自身感受"
          }
        }
      }
    },
    "card.during.long": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pack familiar, portable food and plan drink access"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva alimentos conocidos y fáciles de transportar, y prevé dónde beber"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备熟悉、便携的食物，并安排饮水"
          }
        }
      }
    },
    "card.general.before": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your usual meals and allow time to digest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tus comidas habituales y deja tiempo para digerir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持日常饮食，并留出消化时间"
          }
        }
      }
    },
    "card.general.during": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a drink accessible; individual needs vary"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten una bebida a mano; las necesidades varían"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方便时备好饮品，具体需求因人而异"
          }
        }
      }
    },
    "card.general.after": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to your usual balanced meals"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retoma tus comidas equilibradas habituales"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复日常均衡饮食"
          }
        }
      }
    },
    "advice.during": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short sessions usually need no extra carbohydrate. For longer or harder endurance exercise, familiar food or drink may help; duration alone does not establish your needs. Practice options that suit your digestion. No amounts are calculated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones cortas normalmente no necesitan carbohidratos adicionales. En ejercicio de resistencia más largo o intenso, alimentos o bebidas conocidos pueden ayudar; la duración por sí sola no determina tus necesidades. Practica con opciones que te sienten bien. No se calculan cantidades."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短时间训练通常无需额外补充碳水化合物。较长或较高强度的耐力训练中，熟悉的食物或饮品可能有所帮助；仅凭时长无法确定个人需求。请在训练中尝试适合自己消化习惯的选择。此处不计算用量。"
          }
        }
      }
    },
    "advice.general.during": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The available workout type or duration does not support specific fueling advice. Keep choices familiar and suitable for your dietary needs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo o la duración disponible no permite dar recomendaciones específicas. Elige opciones conocidas y adecuadas para tus necesidades alimentarias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现有训练类型或时长不足以支持具体补给建议。请选择熟悉且适合自身饮食需求的食物和饮品。"
          }
        }
      }
    },
