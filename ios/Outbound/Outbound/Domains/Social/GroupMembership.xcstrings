    "Your Group membership request was declined.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Group membership request was declined."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu solicitud de ingreso al grupo fue rechazada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
