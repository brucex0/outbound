          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要审批"
          }
        }
      }
    },
    "Invitation only": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo por invitación"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限邀请加入"
          }
