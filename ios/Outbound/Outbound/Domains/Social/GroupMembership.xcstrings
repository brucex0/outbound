    },
    "More requests will appear as you review this list.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More requests will appear as you review this list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecerán más solicitudes a medida que revises esta lista."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理后将显示更多待审批申请。"
          }
        }
      }
    },
    "Membership requests": {
      "localizations": {
        "en": {
          "stringUnit": {
