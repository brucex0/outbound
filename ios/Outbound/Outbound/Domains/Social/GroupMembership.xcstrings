    "A Group membership request is ready for review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Group membership request is ready for review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una solicitud de ingreso al grupo pendiente de revisión."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有新的入群申请待审批。"
          }
        }
      }
    },
    "Your Group membership request was approved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Group membership request was approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu solicitud de ingreso al grupo fue aprobada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的入群申请已获批准。"
          }
