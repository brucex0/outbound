    },
    "Approve member invitations": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve member invitations"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobar invitaciones de miembros"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批成员邀请"
          }
        }
      }
    },
    "Members can invite their connections. When approval is required, invitees must accept before an owner or admin reviews their membership. Invitations from owners and admins are pre-approved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Members can invite their connections. When approval is required, invitees must accept before an owner or admin reviews their membership. Invitations from owners and admins are pre-approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los miembros pueden invitar a sus contactos. Si se requiere aprobación, la persona invitada debe aceptar antes de que el propietario o un administrador revise su ingreso. Las invitaciones del propietario y los administradores ya están aprobadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员可以邀请自己的好友。开启审批后，受邀者接受邀请，再由群主或管理员审批入群。群主和管理员发出的邀请无需再次审批。"
          }
        }
      }
    },
    "No membership requests to review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No membership requests to review"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay solicitudes de ingreso pendientes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无待审批的入群申请"
          }
        }
      }
    },
    "Invited by %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invited by %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitación de %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请人：%@"
          }
        }
      }
    },
    "Approve": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve"
          }
        },
        "es": {
