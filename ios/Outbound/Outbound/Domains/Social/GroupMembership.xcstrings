    "Waiting for membership approval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for membership approval"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendiente de aprobación de ingreso"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待入群审批"
          }
        }
      }
    },
    "You accepted this invitation. An owner or admin must approve your membership before you can see Group details.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You accepted this invitation. An owner or admin must approve your membership before you can see Group details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptaste esta invitación. El propietario o un administrador debe aprobar tu ingreso para que puedas ver los detalles del grupo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已接受邀请。群主或管理员批准后，你才能查看群组详情。"
          }
        }
      }
    },
    "Accept this invitation to request membership. An owner or admin will review your request.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept this invitation to request membership. An owner or admin will review your request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepta esta invitación para solicitar el ingreso. El propietario o un administrador revisará tu solicitud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受邀请以申请入群，群主或管理员将审核你的申请。"
          }
        }
      }
    },
    "Withdraw request": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdraw request"
          }
        },
        "es": {
