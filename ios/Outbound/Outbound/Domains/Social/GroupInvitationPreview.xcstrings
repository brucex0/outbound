{
  "sourceLanguage": "en",
  "strings": {
    "group.invitation.organizer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organized by %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizado por %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组织者：%@"
          }
        }
      }
    },
    "group.invitation.preview.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept to join this Group and see the details available to members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepta para unirte a este grupo y ver la información disponible para sus miembros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受邀请加入群组后，即可查看向成员开放的详细信息。"
          }
        }
      }
    },
    "group.invitation.unavailable.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group invitation unavailable"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitación al grupo no disponible"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组邀请不可用"
          }
        }
      }
    },
    "group.invitation.unavailable.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This invitation may have expired or been cancelled, or you may no longer have access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que esta invitación haya caducado o se haya cancelado, o que ya no tengas acceso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此邀请可能已过期或被取消，或者你已无权访问。"
          }
        }
      }
    },
    "group.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading Group…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando grupo…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载群组…"
          }
        }
      }
    }
  },
  "version": "1.0"
}
