      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The widget picker will show the Plainstride options." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El selector mostrará las opciones de Plainstride." } },
