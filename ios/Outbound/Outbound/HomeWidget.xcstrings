    },
    "widget.guide.step1.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Press and hold on your Home Screen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Mantén pulsado un espacio de la pantalla de inicio." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按住主屏幕上的空白处。" } }
      }
    },
    "widget.guide.step2.count" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "2 of 3" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "2 de 3" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第 2 步，共 3 步" } }
