    },
    "widget.guide.step1.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose an open space where your fox can cheer you on." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige un espacio libre para que el zorro te anime." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "找一块空白区域，让小狐狸为你加油。" } }
