    "plan.adjust.reason_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reason is private context only. It does not change your selections or your readiness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motivo es solo contexto privado. No cambia tus elecciones ni tu estado físico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原因仅作为私密备注，不会更改你的选择或恢复状态。"
          }
        }
      }
    },
    "plan.adjust.review_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the server’s proposed schedule. Your plan changes only when you apply it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el calendario propuesto por el servidor. El plan solo cambia cuando lo aplicas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认系统建议的日程。只有点击应用后，计划才会更改。"
          }
        }
      }
    },
    "plan.adjust.no_catchup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The schedule starts from your current training state. There is no catch-up week and the event date does not move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendario parte de tu estado actual. No hay semana de recuperación de sesiones ni se mueve la fecha del evento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日程会从当前训练状态出发，不安排补课周，也不更改赛事日期。"
          }
        }
      }
    },
    "plan.adjust.no_rows": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No currently scheduled workouts change. The adjustment above still applies to future planning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia ninguna sesión del calendario actual. El ajuste de arriba sí se aplica a la planificación futura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前已安排的训练没有变化，上方的调整仍会用于后续计划。"
          }
        }
      }
    },
    "plan.adjust.before": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整前"
          }
        }
      }
    },
    "plan.adjust.after": {
      "extractionState": "manual",
      "localizations": {
