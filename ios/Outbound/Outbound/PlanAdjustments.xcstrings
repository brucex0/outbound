    "plan.adjust.none_available": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No available days"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún día disponible"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无可训练日"
          }
        }
      }
    },
    "plan.adjust.today_paused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan is paused. Open Adjust plan in Plan Details when you’re ready to return. Missed workouts won’t be caught up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan está en pausa. Abre Ajustar plan en Detalles del plan cuando estés listo para volver. No se recuperan las sesiones pendientes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划已暂停。准备好后，请在“计划详情”中打开“调整计划”恢复训练。错过的训练不会补排。"
          }
        }
      }
    },
    "plan.adjust.today_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today is outside your temporary availability. Your plan continues on your available days without catch-up workouts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy no está dentro de tu disponibilidad temporal. El plan continúa en tus días disponibles, sin recuperar sesiones pendientes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天不在临时可训练日内。计划将在可训练日继续，不补练错过的训练。"
          }
        }
      }
    },
    "plan.adjust.edit_pause": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit pause"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar pausa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑暂停设置"
          }
        }
      }
    },
    "plan.adjust.return_summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replanned for a conservative return without catch-up workouts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan actualizado para volver con prudencia, sin recuperar sesiones pendientes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为循序渐进地恢复训练重新安排计划，不补练错过的训练。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
