    "plan.adjust.optional": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional support"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoyo opcional"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选辅助训练"
          }
        }
      }
    },
    "plan.adjust.expiry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previews expire after 15 minutes or when your training context changes. Go back to review a new preview if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa caduca a los 15 minutos o si cambia tu contexto de entrenamiento. Vuelve atrás para generar otra si hace falta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览会在 15 分钟后或训练状态变化时失效。需要时请返回并重新预览。"
          }
        }
      }
    },
    "plan.adjust.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not confirm the change. Your draft is kept. Retry Apply to safely check the same change, or go back for a new preview."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el cambio. Tu borrador se conserva. Reintenta Aplicar para comprobar el mismo cambio, o vuelve atrás para generar otra vista previa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能确认调整，草稿已保留。可再次点击应用以安全确认同一次调整，或返回重新预览。"
          }
        }
      }
    },
    "plan.adjust.stale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan or training context changed, or this preview expired. Your draft is kept. Go back and preview again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan o contexto de entrenamiento cambió, o la vista previa caducó. Tu borrador se conserva. Vuelve atrás y genera otra vista previa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划或训练状态已变化，或预览已过期。草稿已保留，请返回重新预览。"
          }
        }
      }
    },
    "plan.adjust.move_invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That move does not fit the current schedule, recovery spacing, or event boundaries. Choose another date and preview again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese cambio no encaja con el calendario, la recuperación o los límites del evento. Elige otra fecha y genera otra vista previa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此移动不符合当前日程、恢复间隔或赛事阶段要求。请选择其他日期并重新预览。"
          }
        }
      }
    },
    "plan.adjust.rebuild_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The planning engine could not produce a refreshed schedule for this plan. Keep the current plan and review your goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de planificación no pudo generar un calendario nuevo para este plan. Conserva el plan actual y revisa tu objetivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划引擎暂时无法为此计划生成新日程。请保留当前计划并检查目标设置。"
          }
        }
      }
    },
    "plan.adjust.applied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan updated"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan actualizado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划已更新"
          }
        }
      }
    },
    "plan.adjust.pause_active": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan pause saved"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa guardada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停设置已保存"
          }
        }
      }
    },
    "plan.adjust.pause_manage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Adjust plan to review the pause or resume training."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustar plan para revisar la pausa o reanudar el entrenamiento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“调整计划”可查看暂停设置或恢复训练。"
          }
        }
      }
    },
    "plan.adjust.pause_scheduled": {
      "extractionState": "manual",
      "localizations": {
