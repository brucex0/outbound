            "state": "translated",
            "value": "预计恢复：%@ · 需手动恢复"
          }
        }
      }
    },
    "plan.adjust.availability_summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary availability: %@ – %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibilidad temporal: %@ – %@"
          }
        },
        "zh-Hans": {
