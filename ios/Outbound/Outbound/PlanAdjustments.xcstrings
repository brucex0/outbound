{
  "sourceLanguage": "en",
  "strings": {
    "plan.adjust.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust plan"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar plan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整计划"
          }
        }
      }
    },
    "plan.adjust.review_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review changes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisar cambios"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认调整"
          }
        }
      }
    },
    "plan.adjust.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading your plan…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando tu plan…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载计划…"
          }
        }
      }
    },
    "plan.adjust.load_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan could not be loaded. Connect to the internet and retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar tu plan. Conéctate a internet e inténtalo de nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能加载计划。请连接网络后重试。"
          }
        }
      }
    },
    "plan.adjust.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "plan.adjust.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrás"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        }
      }
    },
    "plan.adjust.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "plan.adjust.saving": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardando…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存…"
          }
        }
      }
    },
    "plan.adjust.preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview changes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver cambios"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览调整"
          }
        }
      }
    },
    "plan.adjust.apply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply changes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar cambios"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用调整"
          }
        }
      }
    },
    "plan.adjust.menu_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what needs to change. You’ll review the schedule before applying anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué necesitas cambiar. Podrás revisar el calendario antes de aplicar los cambios."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要调整的内容，应用前可先确认日程。"
          }
        }
      }
    },
    "plan.adjust.move": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move or swap workouts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover o intercambiar sesiones"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动或交换训练"
          }
        }
      }
    },
    "plan.adjust.availability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change available days"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar días disponibles"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改可训练日"
          }
        }
      }
    },
    "plan.adjust.pause": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause plan"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar plan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停计划"
          }
        }
      }
    },
    "plan.adjust.resume": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume or cancel pause"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanudar o cancelar pausa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复计划或取消暂停"
          }
        }
      }
    },
    "plan.adjust.rebuild": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuild remaining plan"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehacer el resto del plan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新安排后续计划"
          }
        }
      }
    },
    "plan.adjust.end": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End temporary adjustment"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizar ajuste temporal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束临时调整"
          }
        }
      }
    },
    "plan.adjust.undo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo last adjustment"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer el último ajuste"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销上次调整"
          }
        }
      }
    },
    "plan.adjust.event": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit event date"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar fecha del evento"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改赛事日期"
          }
        }
      }
    },
    "plan.adjust.more": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More options"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más opciones"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更多选项"
          }
        }
      }
    },
    "plan.adjust.end_adjustment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End adjustment"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizar ajuste"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束调整"
          }
        }
      }
    },
    "plan.adjust.workout_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To shorten, make easier, replace, or skip today’s workout, use Change workout on Today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para acortar, suavizar, sustituir u omitir la sesión de hoy, usa Cambiar sesión en Hoy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需缩短、降低强度、替换或跳过今天的训练，请在“今天”中选择“更改训练”。"
          }
        }
      }
    },
    "plan.adjust.move_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a workout and a new date. If that day has a workout, the two days swap, including optional support sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una sesión y otra fecha. Si ese día tiene una sesión, se intercambian ambos días, incluidas las sesiones opcionales de apoyo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择训练和新日期。如果目标日已有训练，两天的训练将互换，包括可选辅助训练。"
          }
        }
      }
    },
    "plan.adjust.workout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workout"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练"
          }
        }
      }
    },
    "plan.adjust.to_date": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New date"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nueva fecha"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新日期"
          }
        }
      }
    },
    "plan.adjust.move_guard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves stay within your current schedule and preserve recovery spacing, the event date, and taper boundaries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios quedan dentro del calendario actual y respetan la recuperación, la fecha del evento y los límites de la puesta a punto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练只能移至当前日程范围内，并须保留恢复间隔、赛事日期和赛前减量阶段边界。"
          }
        }
      }
    },
    "plan.adjust.availability_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a temporary date range and the days you can train. Other weeks keep their usual rhythm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un periodo temporal y los días en que puedes entrenar. Las demás semanas mantienen su ritmo habitual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择临时时段和可训练日，其他周仍按平常节奏安排。"
          }
        }
      }
    },
    "plan.adjust.from_date": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始日期"
          }
        }
      }
    },
    "plan.adjust.through_date": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Through"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束日期"
          }
        }
      }
    },
    "plan.adjust.available_days": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available days"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Días disponibles"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可训练日"
          }
        }
      }
    },
    "plan.adjust.zero_days": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No days selected means no planned workouts during this period. Extra workouts are never added to catch up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no seleccionas ningún día, no habrá sesiones programadas en este periodo. Nunca se añaden sesiones para recuperar las pendientes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不选择任何一天，表示此时段不安排训练。之后不会增加训练来补课。"
          }
        }
      }
    },
    "plan.adjust.pause_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose when the pause starts. Your saved activities and completed workouts stay in your history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuándo empieza la pausa. Tus actividades guardadas y sesiones completadas se conservan en el historial."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择暂停开始日期。已保存的活动和已完成训练会保留在历史记录中。"
          }
        }
      }
    },
    "plan.adjust.pause_from": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause from"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar desde"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停开始日期"
          }
        }
      }
    },
    "plan.adjust.has_reminder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an estimated return date"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir fecha estimada de regreso"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加预计恢复日期"
          }
        }
      }
    },
    "plan.adjust.return_date": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated return"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regreso estimado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预计恢复日期"
          }
        }
      }
    },
    "plan.adjust.reminder_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The return date is a reminder here, not an automatic restart. Come back to Adjust plan when you’re ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de regreso sirve como referencia aquí; el plan no se reanuda solo. Vuelve a Ajustar plan cuando estés listo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预计恢复日期仅在此处作为提醒，不会自动重启计划。准备好后，请回到“调整计划”。"
          }
        }
      }
    },
    "plan.adjust.resume_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check how you feel before returning. Your recent training and current readiness guide the refreshed schedule; missed sessions are not caught up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valora cómo te sientes antes de volver. Tu entrenamiento reciente y tu estado actual guían el nuevo calendario; no se recuperan sesiones pendientes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复前请确认身体状态。新日程会依据近期训练和当前恢复状态安排，不补练错过的训练。"
          }
        }
      }
    },
    "plan.adjust.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I feel ready to review my return"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me siento listo para revisar mi regreso"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已准备好查看恢复训练安排"
          }
        }
      }
    },
    "plan.adjust.not_ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you still feel unwell or need more rest, leave the pause in place. This check does not change your readiness report."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sigues encontrándote mal o necesitas descansar más, mantén la pausa. Esta confirmación no cambia tu registro de estado físico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果仍感不适或需要更多休息，请保持暂停。此确认不会更改你的恢复状态记录。"
          }
        }
      }
    },
    "plan.adjust.rebuild_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh only the remaining schedule using your current goal, training history, and readiness. Completed workouts and event dates stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza solo el calendario pendiente según tu objetivo, historial y estado actuales. Las sesiones completadas y las fechas de eventos se conservan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据当前目标、训练历史和恢复状态重新安排后续日程。已完成训练和赛事日期保持不变。"
          }
        }
      }
    },
    "plan.adjust.end_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the temporary weekday adjustment and review a fresh schedule with your usual availability. Missed workouts are not added back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finaliza el ajuste temporal de días y revisa un calendario con tu disponibilidad habitual. No se recuperan las sesiones pendientes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束临时可训练日调整，并预览按平常可训练日重新安排的日程。错过的训练不会补排。"
          }
        }
      }
    },
    "plan.adjust.undo_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore the previous adjustment only while the affected future schedule is unchanged. Completed workouts and saved activities are never undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura el ajuste anterior solo si el calendario futuro afectado no ha cambiado. Las sesiones completadas y actividades guardadas nunca se deshacen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当相关后续日程尚未变化时，才能撤销上次调整。已完成训练和已保存活动不会被撤销。"
          }
        }
      }
    },
    "plan.adjust.reason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reason (optional)"
