        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配速提醒已关闭"
          }
        }
      }
    },
    "watch.pace.alert.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrates when pace is more than 30 sec/km from your target. Pace uses a 15-second rolling window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra si el ritmo se desvía más de 30 s/km del objetivo. El ritmo se calcula con los últimos 15 segundos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配速偏离目标超过每公里 30 秒时振动提醒。配速根据最近 15 秒的数据计算。"
          }
        }
      }
    },
    "watch.route.permission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Route unavailable. Allow Location in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruta no disponible. Permite la ubicación en Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法记录路线。请在设置中允许定位。"
          }
        }
      }
    },
    "watch.pace.alerts": {
      "localizations": {
