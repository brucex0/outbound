      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pace alerts off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisos de ritmo desactivados"
          }
